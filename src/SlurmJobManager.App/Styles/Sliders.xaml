<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Red-themed Slider styles ──────────────────────────────────────────
         Track unselected : #3A1E1E  (dark red)
         Track selected   : #E53935  (main red)
         Thumb normal     : #FF4D4F  (bright red)
         Thumb hover      : #FF7875  (lighter red)
         Thumb pressed    : #D32F2F  (darker red)
         Disabled         : 40 % opacity

         Root-cause fix: ScaleTransform is defined inline inside the Thumb's
         ControlTemplate (per-instance, never frozen) and animated via
         EventTrigger + DoubleAnimation.  The original Style.Triggers approach
         replaced the shared/frozen RenderTransform Setter value, which caused
         both frozen-object crashes and instant-jump jitter.

         Thumb fill colour is also a named per-instance SolidColorBrush so that
         hover/press Setters mutate the brush's Color, not replace the brush.
    ──────────────────────────────────────────────────────────────────────── -->

    <!-- RepeatButton used for the decrease (filled) portion of the track -->
    <Style x:Key="SliderDecreaseButtonStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop"             Value="False" />
        <Setter Property="Focusable"             Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="#E53935" CornerRadius="2" Height="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RepeatButton used for the increase (unfilled) portion of the track -->
    <Style x:Key="SliderIncreaseButtonStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop"             Value="False" />
        <Setter Property="Focusable"             Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="#3A1E1E" CornerRadius="2" Height="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thumb style.
         ScaleTransform and fill colour are defined INSIDE the ControlTemplate
         as named per-instance objects (ThumbScale, ThumbFillBrush) so they are
         never frozen.  Hover scale uses EventTrigger + DoubleAnimation for a
         smooth transition; colour changes use VisualStateManager. -->
    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle"      Value="{x:Null}" />
        <Setter Property="Width"                 Value="14" />
        <Setter Property="Height"                Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="ThumbCircle"
                             Width="{TemplateBinding Width}"
                             Height="{TemplateBinding Height}"
                             RenderTransformOrigin="0.5,0.5"
                             SnapsToDevicePixels="True"
                             UseLayoutRounding="True">
                        <!-- Per-instance fill brush — Setter below mutates Color, never replaces brush -->
                        <Ellipse.Fill>
                            <SolidColorBrush x:Name="ThumbFillBrush" Color="#FF4D4F" />
                        </Ellipse.Fill>
                        <!-- Per-instance ScaleTransform — animated by EventTriggers below -->
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <ControlTemplate.Triggers>
                        <!-- Colour: EventTrigger animations target named brush (no freeze risk) -->
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="ThumbFillBrush"
                                                    Storyboard.TargetProperty="Color"
                                                    To="#FF7875" Duration="0:0:0.1" />
                                    <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.25" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.25" Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="ThumbFillBrush"
                                                    Storyboard.TargetProperty="Color"
                                                    To="#FF4D4F" Duration="0:0:0.1" />
                                    <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <!-- Scale stays at 1.25 while dragging; restore when drag ends -->
                        <EventTrigger RoutedEvent="DragStarted">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="ThumbFillBrush"
                                                    Storyboard.TargetProperty="Color"
                                                    To="#D32F2F" Duration="0:0:0.08" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="DragCompleted">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="ThumbFillBrush"
                                                    Storyboard.TargetProperty="Color"
                                                    To="#FF4D4F" Duration="0:0:0.1" />
                                    <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1" Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global Slider style (horizontal) -->
    <Style TargetType="Slider">
        <Setter Property="OverridesDefaultStyle"  Value="True" />
        <Setter Property="FocusVisualStyle"       Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels"    Value="True" />
        <Setter Property="UseLayoutRounding"      Value="True" />
        <Setter Property="IsMoveToPointEnabled"   Value="True" />
        <Setter Property="Minimum"               Value="0" />
        <Setter Property="Maximum"               Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <!-- Fixed-height container prevents parent re-measure when Thumb scales
                         (RenderTransform is purely visual and does not affect layout). -->
                    <Border Height="24" Background="Transparent"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderDecreaseButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderIncreaseButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
