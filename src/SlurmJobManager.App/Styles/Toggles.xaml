<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Unified Toggle-Switch style for CheckBox (reference image).
          On  → blue  track (#2979FF) + white  thumb shifted right
          Off → gray  track (#44444C) + light-gray thumb on left
        Animation: 150 ms ThicknessAnimation on thumb Margin +
                   ColorAnimation via property paths on Track/Thumb elements.
        Row-click linkage: wrap the CheckBox in a Label with Target binding.
    -->

    <Style TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle"       Value="{x:Null}" />
        <Setter Property="Cursor"                 Value="Hand" />
        <Setter Property="VerticalAlignment"      Value="Center" />
        <Setter Property="SnapsToDevicePixels"    Value="True" />
        <Setter Property="UseLayoutRounding"      Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Fixed outer height prevents layout jitter during animation -->
                    <Border Background="Transparent" Height="26" SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center" Width="40" Height="22">

                            <!-- Track: Background color animated via property path -->
                            <Border x:Name="Track"
                                    Background="#44444C"
                                    CornerRadius="11"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True" />

                            <!-- Thumb: Margin.Left drives position (animated via ThicknessAnimation) -->
                            <Ellipse x:Name="Thumb"
                                     Width="16" Height="16"
                                     Fill="#A0A0AC"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="3,0,0,0"
                                     SnapsToDevicePixels="True"
                                     UseLayoutRounding="True" />

                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Checked → On: animate thumb right + blue track + white thumb -->
                        <EventTrigger RoutedEvent="Checked">
                            <BeginStoryboard>
                                <Storyboard FillBehavior="Stop">
                                    <ThicknessAnimation
                                        Storyboard.TargetName="Thumb"
                                        Storyboard.TargetProperty="Margin"
                                        To="21,0,0,0" Duration="0:0:0.15">
                                        <ThicknessAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </ThicknessAnimation.EasingFunction>
                                    </ThicknessAnimation>
                                    <ColorAnimation
                                        Storyboard.TargetName="Track"
                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                        To="#2979FF" Duration="0:0:0.15" />
                                    <ColorAnimation
                                        Storyboard.TargetName="Thumb"
                                        Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)"
                                        To="White" Duration="0:0:0.15" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <!-- Unchecked → Off: animate thumb left + gray track + gray thumb -->
                        <EventTrigger RoutedEvent="Unchecked">
                            <BeginStoryboard>
                                <Storyboard FillBehavior="Stop">
                                    <ThicknessAnimation
                                        Storyboard.TargetName="Thumb"
                                        Storyboard.TargetProperty="Margin"
                                        To="3,0,0,0" Duration="0:0:0.15">
                                        <ThicknessAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </ThicknessAnimation.EasingFunction>
                                    </ThicknessAnimation>
                                    <ColorAnimation
                                        Storyboard.TargetName="Track"
                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                        To="#44444C" Duration="0:0:0.15" />
                                    <ColorAnimation
                                        Storyboard.TargetName="Thumb"
                                        Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)"
                                        To="#A0A0AC" Duration="0:0:0.15" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <!-- Static initial state: set directly on named elements (no animation at load) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Thumb"  Property="Margin"     Value="21,0,0,0" />
                            <Setter TargetName="Track"  Property="Background" Value="#2979FF" />
                            <Setter TargetName="Thumb"  Property="Fill"       Value="White" />
                        </Trigger>

                        <!-- Hover: brighten track -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked"   Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="#55555E" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked"   Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="#448AFF" />
                        </MultiTrigger>

                        <!-- Pressed: darken track -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="#333338" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="#1565C0" />
                        </MultiTrigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
