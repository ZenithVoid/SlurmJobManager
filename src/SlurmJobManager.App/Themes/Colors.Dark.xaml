<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Dark palette (Catppuccin Mocha-inspired) ────────────────────────── -->
    <Color x:Key="BgBaseColor">#1E1E2E</Color>
    <Color x:Key="BgMantle">#181825</Color>
    <Color x:Key="BgCrust">#11111B</Color>
    <Color x:Key="BgSurface0">#313244</Color>
    <Color x:Key="BgSurface1">#45475A</Color>
    <Color x:Key="BgSurface2">#585B70</Color>
    <Color x:Key="BgOverlay0">#6C7086</Color>
    <Color x:Key="BgPanel">#2A2A3E</Color>
    <Color x:Key="BgCard">#252535</Color>
    <Color x:Key="BorderColor">#3A3A5C</Color>

    <Color x:Key="TextPrimary">#CDD6F4</Color>
    <Color x:Key="TextSecondary">#A6ADC8</Color>
    <Color x:Key="TextMuted">#6C7086</Color>
    <Color x:Key="TextOnAccent">#1E1E2E</Color>

    <Color x:Key="AccentBlue">#89B4FA</Color>
    <Color x:Key="AccentGreen">#A6E3A1</Color>
    <Color x:Key="AccentRed">#F38BA8</Color>
    <Color x:Key="AccentYellow">#F9E2AF</Color>
    <Color x:Key="AccentPurple">#CBA6F7</Color>
    <Color x:Key="AccentPeach">#FAB387</Color>

    <!-- Job state colours -->
    <Color x:Key="StateRunning">#A6E3A1</Color>
    <Color x:Key="StatePending">#F9E2AF</Color>
    <Color x:Key="StateFailed">#F38BA8</Color>
    <Color x:Key="StateCancelled">#FAB387</Color>
    <Color x:Key="StateCompleted">#89B4FA</Color>
    <Color x:Key="StateDefault">#CDD6F4</Color>

    <!-- Scrollbar colours -->
    <Color x:Key="ScrollThumb">#4A4A6A</Color>
    <Color x:Key="ScrollThumbHover">#6A6A9A</Color>
    <Color x:Key="ScrollThumbActive">#89B4FA</Color>
    <Color x:Key="ScrollTrack">#1A1A28</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BgBaseBrush"      Color="{StaticResource BgBaseColor}" />
    <SolidColorBrush x:Key="BgMantleBrush"    Color="{StaticResource BgMantle}" />
    <SolidColorBrush x:Key="BgCrustBrush"     Color="{StaticResource BgCrust}" />
    <SolidColorBrush x:Key="BgSurface0Brush"  Color="{StaticResource BgSurface0}" />
    <SolidColorBrush x:Key="BgSurface1Brush"  Color="{StaticResource BgSurface1}" />
    <SolidColorBrush x:Key="BgSurface2Brush"  Color="{StaticResource BgSurface2}" />
    <SolidColorBrush x:Key="BgOverlay0Brush"  Color="{StaticResource BgOverlay0}" />
    <SolidColorBrush x:Key="BgPanelBrush"     Color="{StaticResource BgPanel}" />
    <SolidColorBrush x:Key="BgCardBrush"      Color="{StaticResource BgCard}" />
    <SolidColorBrush x:Key="BorderBrush"      Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="TextOnAccentBrush"  Color="{StaticResource TextOnAccent}" />

    <SolidColorBrush x:Key="AccentBlueBrush"   Color="{StaticResource AccentBlue}" />
    <SolidColorBrush x:Key="AccentGreenBrush"  Color="{StaticResource AccentGreen}" />
    <SolidColorBrush x:Key="AccentRedBrush"    Color="{StaticResource AccentRed}" />
    <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentYellow}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}" />
    <SolidColorBrush x:Key="AccentPeachBrush"  Color="{StaticResource AccentPeach}" />

    <SolidColorBrush x:Key="StateRunningBrush"   Color="{StaticResource StateRunning}" />
    <SolidColorBrush x:Key="StatePendingBrush"   Color="{StaticResource StatePending}" />
    <SolidColorBrush x:Key="StateFailedBrush"    Color="{StaticResource StateFailed}" />
    <SolidColorBrush x:Key="StateCancelledBrush" Color="{StaticResource StateCancelled}" />
    <SolidColorBrush x:Key="StateCompletedBrush" Color="{StaticResource StateCompleted}" />
    <SolidColorBrush x:Key="StateDefaultBrush"   Color="{StaticResource StateDefault}" />

    <SolidColorBrush x:Key="ScrollThumbBrush"       Color="{StaticResource ScrollThumb}" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush"  Color="{StaticResource ScrollThumbHover}" />
    <SolidColorBrush x:Key="ScrollThumbActiveBrush" Color="{StaticResource ScrollThumbActive}" />
    <SolidColorBrush x:Key="ScrollTrackBrush"       Color="{StaticResource ScrollTrack}" />

</ResourceDictionary>
