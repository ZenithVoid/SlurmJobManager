<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SlurmJobManager.App</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\AppIcon\server-palm.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SlurmJobManager.Core\SlurmJobManager.Core.csproj" />
    <ProjectReference Include="..\SlurmJobManager.Infrastructure\SlurmJobManager.Infrastructure.csproj" />
    <ProjectReference Include="..\SlurmJobManager.Updater\SlurmJobManager.Updater.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="XTerm.NET" Version="1.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon\server-palm.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\COPYRIGHT" Link="COPYRIGHT" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyUpdaterArtifacts" AfterTargets="Build">
    <MSBuild Projects="..\SlurmJobManager.Updater\SlurmJobManager.Updater.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <UpdaterBuildOutput Include="..\SlurmJobManager.Updater\bin\$(Configuration)\net8.0-windows\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterBuildOutput)"
          DestinationFiles="@(UpdaterBuildOutput->'$(OutDir)Updater\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
