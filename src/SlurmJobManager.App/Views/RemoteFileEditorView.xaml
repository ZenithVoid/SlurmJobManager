<Window
    x:Class="SlurmJobManager.App.Views.RemoteFileEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SlurmJobManager.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{Binding WindowTitle}"
    Height="540" Width="680"
    MinHeight="320" MinWidth="440"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource BgBaseBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Remote path label -->
        <TextBlock Grid.Row="0"
                   Text="{Binding RemotePath}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontFamily="Consolas" FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,6" />

        <!-- Editor -->
        <TextBox Grid.Row="1"
                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                 Background="{DynamicResource BgCrustBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="1"
                 Padding="8,6"
                 FontFamily="Consolas" FontSize="12"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 IsReadOnly="{Binding IsBusy}" />

        <!-- Status -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource AccentYellowBrush}"
                   FontSize="11" Margin="0,4,0,4"
                   TextWrapping="Wrap" />

        <!-- Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{DynamicResource RemoteEditor.Saving}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" VerticalAlignment="Center"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <Button Grid.Column="1" Content="{DynamicResource RemoteEditor.Save}"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="12,5" Margin="0,0,6,0" />
            <Button Grid.Column="2" Content="{DynamicResource RemoteEditor.Close}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="12,5"
                    Click="BtnClose_Click" />
        </Grid>
    </Grid>
</Window>
