<Window
    x:Class="SlurmJobManager.App.Views.RemoteFileEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:conv="clr-namespace:SlurmJobManager.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{Binding WindowTitle}"
    Height="540" Width="680"
    MinHeight="320" MinWidth="440"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource BgBaseBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding FileName}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RemotePath}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontFamily="Consolas" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{DynamicResource BgSurface1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,3"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding EncodingName}"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="11" />
            </Border>
        </Grid>

        <!-- Editor -->
        <TextBlock Grid.Row="1"
                   Text="{DynamicResource RemoteEditor.BinaryRejected}"
                   Foreground="{DynamicResource AccentYellowBrush}"
                   FontSize="12"
                   Margin="0,0,0,6"
                   Visibility="{Binding IsBinaryFile, Converter={StaticResource BoolToVis}}" />

        <Border Grid.Row="2"
                Background="{DynamicResource BgCrustBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBinaryFile}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <avalonedit:TextEditor x:Name="Editor"
                                   Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                   ShowLineNumbers="True"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   Background="{DynamicResource BgCrustBrush}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   IsReadOnly="{Binding IsBusy}"
                                   WordWrap="False"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto" />
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource AccentYellowBrush}"
                   FontSize="11" Margin="0,4,0,4"
                   TextWrapping="Wrap" />

        <!-- Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{DynamicResource RemoteEditor.Saving}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" VerticalAlignment="Center"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <Button Grid.Column="1" Content="{DynamicResource RemoteEditor.Save}"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="12,5" Margin="0,0,6,0" />
            <Button Grid.Column="2" Content="{DynamicResource RemoteEditor.Close}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="12,5"
                    Click="BtnClose_Click" />
        </Grid>
    </Grid>
</Window>
