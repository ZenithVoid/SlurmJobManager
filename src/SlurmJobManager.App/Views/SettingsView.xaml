<UserControl
    x:Class="SlurmJobManager.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:SlurmJobManager.App.Behaviors"
    xmlns:conv="clr-namespace:SlurmJobManager.App.Converters"
    xmlns:views="clr-namespace:SlurmJobManager.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="700"
    Background="{DynamicResource BgBaseBrush}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="LocaleZhButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentLocale, Mode=OneWay}" Value="zh-CN">
                    <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LocaleEnButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentLocale, Mode=OneWay}" Value="en-US">
                    <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UpdateConnectionTestStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding UpdateConnectionTestStatusTone, Mode=OneWay}" Value="Success">
                    <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding UpdateConnectionTestStatusTone, Mode=OneWay}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource AccentYellowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding UpdateConnectionTestStatusTone, Mode=OneWay}" Value="Failure">
                    <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0" b:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="24,20,24,20">
            <TextBlock Text="{DynamicResource Settings.Title}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock
                Margin="0,4,0,16"
                Text="{DynamicResource Settings.AutoSaveHint}"
                Style="{StaticResource MutedTextStyle}"
                TextWrapping="Wrap" />

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.GroupGeneralTitle}" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Text="{DynamicResource Settings.GroupGeneralDesc}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,0,0,4" Text="{DynamicResource Settings.SshConnection}" Style="{StaticResource FieldLabelStyle}" />
                    <views:ConnectionView DataContext="{Binding Connection, Mode=OneWay}" />

                    <TextBlock Margin="0,10,0,2" Text="{DynamicResource Settings.StartupBehavior}" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox
                            x:Name="AutoConnectCheckBox"
                            Margin="0,0,10,0"
                            IsChecked="{Binding AutoConnectOnStartup, Mode=TwoWay}" />
                        <Label
                            Padding="0"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Target="{Binding ElementName=AutoConnectCheckBox}"
                            Content="{DynamicResource Settings.AutoConnectLabel}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Settings.AutoConnectDesc}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Text="{DynamicResource Settings.AutoConnectEffect}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                        <CheckBox
                            x:Name="AutoRestoreLastTaskCheckBox"
                            Margin="0,0,10,0"
                            IsChecked="{Binding AutoRestoreLastTaskOnLogin, Mode=TwoWay}" />
                        <Label
                            Padding="0"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Target="{Binding ElementName=AutoRestoreLastTaskCheckBox}"
                            Content="{DynamicResource Settings.AutoRestoreLastTaskLabel}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Settings.AutoRestoreLastTaskDesc}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Text="{DynamicResource Settings.AutoRestoreLastTaskEffect}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,10,0,2" Text="{DynamicResource Settings.Appearance}" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Text="{DynamicResource Settings.Theme}"
                            Style="{StaticResource FieldLabelStyle}" />
                        <Button
                            Padding="12,6"
                            Command="{Binding ToggleThemeCommand}"
                            Content="{Binding ThemeLabel, Mode=OneWay}"
                            Style="{StaticResource NeutralButtonStyle}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Settings.ThemeDesc}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Text="{DynamicResource Settings.ThemeEffect}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,10,0,2" Text="{DynamicResource Settings.Language}" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Text="{DynamicResource Settings.LanguageLabel}"
                            Style="{StaticResource FieldLabelStyle}" />
                        <Button
                            Margin="0,0,6,0"
                            Padding="10,5"
                            Command="{Binding SwitchLocaleCommand}"
                            CommandParameter="zh-CN"
                            Content="{DynamicResource Settings.LangZhCN}"
                            Style="{StaticResource LocaleZhButtonStyle}" />
                        <Button
                            Padding="10,5"
                            Command="{Binding SwitchLocaleCommand}"
                            CommandParameter="en-US"
                            Content="{DynamicResource Settings.LangEnUS}"
                            Style="{StaticResource LocaleEnButtonStyle}" />
                    </StackPanel>
                    <Border
                        Margin="0,0,0,6"
                        Padding="10,8"
                        Background="{DynamicResource BgPanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                            <Run Text="{DynamicResource Settings.CurrentLanguage}" />
                            <Run Text="{Binding CurrentLocaleDisplayName, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{DynamicResource Settings.LanguageEffect}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Margin="0,10,0,2" Text="{DynamicResource Settings.PollingPerf}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Text="{DynamicResource Settings.PollIntervalLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Slider
                            Width="200"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Maximum="60"
                            Minimum="2"
                            Value="{Binding PollIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            MinWidth="28"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{Binding PollIntervalSeconds}" />
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Units.SecondShort}" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Settings.PollIntervalDesc}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Text="{DynamicResource Settings.PollIntervalEffect}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Text="{DynamicResource Settings.HistoryQueryRangeDesc}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.GroupPathsTitle}" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Text="{DynamicResource Settings.GroupPathsDesc}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />

                    <TextBlock Text="{DynamicResource Settings.DefaultRemotePickerDirectoryLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox
                        Text="{Binding DefaultRemotePickerDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                        ToolTip="{DynamicResource Settings.DefaultRemotePickerDirectoryDesc}" />
                    <TextBlock
                        Margin="0,4,0,8"
                        Text="{DynamicResource Settings.DefaultRemotePickerDirectoryDesc}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="{DynamicResource Settings.LocalDataRootLabel}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextMutedBrush}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="ⓘ"
                            ToolTip="{DynamicResource Settings.LocalDataDesc}" />
                    </StackPanel>
                    <TextBox
                        Margin="0,0,0,8"
                        IsReadOnly="True"
                        Text="{Binding LocalDataDirectory, Mode=OneWay}"
                        ToolTip="{Binding LocalDataDirectory, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button
                            Margin="0,0,6,0"
                            Padding="10,5"
                            Command="{Binding OpenDataDirectoryCommand}"
                            Content="{DynamicResource Settings.OpenDataDirectory}"
                            Style="{StaticResource NeutralButtonStyle}" />
                        <Button
                            Padding="10,5"
                            Command="{Binding CopyDataDirectoryCommand}"
                            Content="{DynamicResource Settings.CopyDataDirectory}"
                            Style="{StaticResource NeutralButtonStyle}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        TextWrapping="Wrap"
                        ToolTip="{Binding TasksDirectory, Mode=OneWay}">
                        <Run Text="• " />
                        <Run Text="{DynamicResource Settings.LocalDataTasks}" />
                        <Run Text="{Binding TasksDirectory, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        TextWrapping="Wrap"
                        ToolTip="{Binding BlueprintsDirectory, Mode=OneWay}">
                        <Run Text="• " />
                        <Run Text="{DynamicResource Settings.LocalDataBlueprints}" />
                        <Run Text="{Binding BlueprintsDirectory, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        TextWrapping="Wrap"
                        ToolTip="{Binding LogsDirectory, Mode=OneWay}">
                        <Run Text="• " />
                        <Run Text="{DynamicResource Settings.LocalDataLogs}" />
                        <Run Text="{Binding LogsDirectory, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        TextWrapping="Wrap"
                        ToolTip="{Binding RecentConnectionsFilePath, Mode=OneWay}">
                        <Run Text="• " />
                        <Run Text="{DynamicResource Settings.LocalDataRecentConnections}" />
                        <Run Text="{Binding RecentConnectionsFilePath, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        TextWrapping="Wrap"
                        ToolTip="{Binding PreferencesFilePath, Mode=OneWay}">
                        <Run Text="• " />
                        <Run Text="{DynamicResource Settings.LocalDataPreferences}" />
                        <Run Text="{Binding PreferencesFilePath, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        TextWrapping="Wrap"
                        ToolTip="{Binding LastTaskContextsFilePath, Mode=OneWay}">
                        <Run Text="• " />
                        <Run Text="{DynamicResource Settings.LocalDataLastTaskContexts}" />
                        <Run Text="{Binding LastTaskContextsFilePath, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.GroupNetworkTitle}" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Text="{DynamicResource Settings.GroupNetworkDesc}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox
                            x:Name="UseProxyForUpdatesCheckBox"
                            Margin="0,0,10,0"
                            IsChecked="{Binding UseProxyForUpdates, Mode=TwoWay}" />
                        <Label
                            Padding="0"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Target="{Binding ElementName=UseProxyForUpdatesCheckBox}"
                            Content="{DynamicResource Settings.UpdateUseProxyLabel}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Text="{DynamicResource Settings.UpdateUseProxyDesc}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />

                    <TextBlock Text="{DynamicResource Settings.UpdateProxyModeLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox
                        SelectedIndex="{Binding SelectedUpdateProxyModeIndex, Mode=TwoWay}"
                        Margin="0,0,0,4"
                        MinHeight="32"
                        VerticalContentAlignment="Center">
                        <ComboBoxItem Content="{DynamicResource Settings.UpdateProxyModeNoProxy}" />
                        <ComboBoxItem Content="{DynamicResource Settings.UpdateProxyModeSystem}" />
                        <ComboBoxItem Content="{DynamicResource Settings.UpdateProxyModeCustom}" />
                    </ComboBox>
                    <TextBlock
                        Margin="0,0,0,8"
                        Text="{DynamicResource Settings.UpdateProxyModeCustomDesc}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap"
                        Visibility="{Binding IsUpdateProxyDetailVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Visibility="{Binding ShouldShowCustomProxyFields, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Settings.UpdateProxyHostLabel}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox
                            Margin="0,0,0,4"
                            Text="{Binding UpdateCustomProxyHost, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock
                            Margin="0,0,0,8"
                            Text="{DynamicResource Settings.UpdateProxyHostDesc}"
                            Style="{StaticResource MutedTextStyle}"
                            TextWrapping="Wrap" />

                        <TextBlock Text="{DynamicResource Settings.UpdateProxyPortLabel}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox
                            Margin="0,0,0,4"
                            Text="{Binding UpdateCustomProxyPortText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="{DynamicResource Settings.UpdateProxyPortDesc}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Margin="0,10,0,4" Text="{DynamicResource Settings.NetworkActionsLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button
                            Margin="0,0,6,0"
                            Padding="10,5"
                            Command="{Binding TestUpdateConnectivityCommand}"
                            Content="{DynamicResource Settings.TestUpdateConnectivityButton}"
                            Style="{StaticResource NeutralButtonStyle}" />
                        <Button
                            Padding="10,5"
                            Command="{Binding OpenUpdateSourceCommand}"
                            Content="{DynamicResource Settings.OpenUpdateSourceButton}"
                            Style="{StaticResource NeutralButtonStyle}" />
                    </StackPanel>

                    <Border
                        Padding="10,8"
                        Background="{DynamicResource BgPanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.UpdateConnectionTestStatusLabel}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Text="{Binding UpdateConnectionTestStatusMessage, Mode=OneWay}"
                                Style="{StaticResource UpdateConnectionTestStatusStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                                <Run Text="{DynamicResource Settings.UpdateConnectionTargetLabel}" />
                                <Run Text="{Binding UpdateConnectionTestTarget, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                                <Run Text="{DynamicResource Settings.UpdateConnectionProxyLabel}" />
                                <Run Text="{Binding UpdateConnectionTestProxyPolicy, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                                <Run Text="{DynamicResource Settings.UpdateConnectionDurationLabel}" />
                                <Run Text="{Binding UpdateConnectionTestDuration, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource AccentRedBrush}"
                                Text="{Binding UpdateConnectionTestErrorSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Text="{Binding UpdateConnectionTestSuggestion, Mode=OneWay}"
                                Style="{StaticResource MutedTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.GroupUpdatesTitle}" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Text="{DynamicResource Settings.GroupUpdatesDesc}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />

                    <TextBlock Text="{DynamicResource Settings.UpdateCurrentVersionLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding CurrentAppVersion, Mode=OneWay}" />

                    <TextBlock Text="{DynamicResource Settings.UpdateSourceLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox SelectedIndex="{Binding SelectedUpdateSourceIndex, Mode=TwoWay}" Margin="0,0,0,6">
                        <ComboBoxItem Content="{DynamicResource Settings.UpdateSourceGitHub}" />
                        <ComboBoxItem Content="{DynamicResource Settings.UpdateSourceFolder}" />
                    </ComboBox>
                    <TextBlock
                        Margin="0,0,0,8"
                        Text="{DynamicResource Settings.UpdateSourceDesc}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />

                    <TextBlock Text="{DynamicResource Settings.UpdateFolderPathLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox
                        Margin="0,0,0,4"
                        IsEnabled="{Binding IsFolderUpdateSource, Mode=OneWay}"
                        Text="{Binding UpdateFolderPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock
                        Margin="0,0,0,8"
                        Text="{DynamicResource Settings.UpdateFolderPathDesc}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox
                            x:Name="AutoCheckUpdatesCheckBox"
                            Margin="0,0,10,0"
                            IsChecked="{Binding AutoCheckForUpdatesOnStartup, Mode=TwoWay}" />
                        <Label
                            Padding="0"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Target="{Binding ElementName=AutoCheckUpdatesCheckBox}"
                            Content="{DynamicResource Settings.AutoCheckUpdateLabel}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Settings.AutoCheckUpdateDesc}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <CheckBox
                            x:Name="IncludePrereleaseCheckBox"
                            Margin="0,0,10,0"
                            IsChecked="{Binding IncludePrereleaseUpdates, Mode=TwoWay}"
                            IsEnabled="{Binding IsGitHubUpdateSource, Mode=OneWay}" />
                        <Label
                            Padding="0"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Target="{Binding ElementName=IncludePrereleaseCheckBox}"
                            Content="{DynamicResource Settings.IncludePrereleaseLabel}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Settings.IncludePrereleaseDesc}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Margin="0,10,0,4" Text="{DynamicResource Settings.UpdateActionsLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button
                            Margin="0,0,6,0"
                            Padding="10,5"
                            Command="{Binding CheckForUpdatesCommand}"
                            Content="{DynamicResource Settings.CheckUpdateButton}"
                            Style="{StaticResource NeutralButtonStyle}" />
                        <Button
                            Margin="0,0,6,0"
                            Padding="10,5"
                            Command="{Binding OpenUpdateTargetCommand}"
                            Content="{DynamicResource Settings.OpenUpdateTargetButton}"
                            Style="{StaticResource NeutralButtonStyle}" />
                        <Button
                            Padding="10,5"
                            Command="{Binding LaunchUpdateCommand}"
                            Content="{DynamicResource Settings.StartUpdateButton}"
                            Style="{StaticResource NeutralButtonStyle}" />
                    </StackPanel>

                    <Border
                        Padding="10,8"
                        Background="{DynamicResource BgPanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                                <Run Text="{DynamicResource Settings.UpdateStatusLabel}" />
                                <Run Text="{Binding UpdateStatusMessage, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                                <Run Text="{DynamicResource Settings.UpdateLatestVersionLabel}" />
                                <Run Text="{Binding LatestVersionDisplay, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                                <Run Text="{DynamicResource Settings.UpdateResultSourceLabel}" />
                                <Run Text="{Binding UpdateSourceDisplay, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                                <Run Text="{DynamicResource Settings.UpdateReleaseTitleLabel}" />
                                <Run Text="{Binding ReleaseTitle, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                                <Run Text="{DynamicResource Settings.UpdateReleaseTimeLabel}" />
                                <Run Text="{Binding ReleasePublishedAt, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                                <Run Text="{DynamicResource Settings.UpdateLastCheckedLabel}" />
                                <Run Text="{Binding LastCheckedAtDisplay, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                Margin="0,6,0,0"
                                Text="{Binding ReleaseNotes, Mode=OneWay}"
                                Style="{StaticResource MutedTextStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.GroupLogsTitle}" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Text="{DynamicResource Settings.GroupLogsDesc}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />

                    <TextBlock Text="{DynamicResource Settings.LogDirectoryLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox
                        Margin="0,0,0,8"
                        IsReadOnly="True"
                        Text="{Binding LogsDirectory, Mode=OneWay}"
                        ToolTip="{Binding LogsDirectory, Mode=OneWay}" />

                    <TextBlock Text="{DynamicResource Settings.LogActionsLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button
                            Margin="0,0,6,0"
                            Padding="10,5"
                            Command="{Binding OpenLogDirectoryCommand}"
                            Content="{DynamicResource Settings.OpenLogsDirectory}"
                            Style="{StaticResource NeutralButtonStyle}" />
                        <Button
                            Margin="0,0,6,0"
                            Padding="10,5"
                            Command="{Binding ViewRecentLogCommand}"
                            Content="{DynamicResource Settings.ViewRecentLog}"
                            Style="{StaticResource NeutralButtonStyle}" />
                        <Button
                            Padding="10,5"
                            Command="{Binding ExportLogsCommand}"
                            Content="{DynamicResource Settings.ExportLogs}"
                            Style="{StaticResource NeutralButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.GroupAboutTitle}" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Text="{DynamicResource Settings.GroupAboutDesc}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{DynamicResource Settings.AppName}" />
                    <TextBlock Text="{DynamicResource Settings.AppDesc}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Margin="0,10,0,4" Text="{DynamicResource Settings.AboutActionsLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Margin="0,0,6,0"
                            Padding="10,5"
                            Command="{Binding OpenAboutPageCommand}"
                            Content="{DynamicResource Settings.OpenAboutPageButton}"
                            Style="{StaticResource NeutralButtonStyle}" />
                        <Button
                            Padding="10,5"
                            Command="{Binding OpenRepositoryCommand}"
                            Content="{DynamicResource Settings.OpenRepositoryButton}"
                            Style="{StaticResource NeutralButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,16"
                Style="{StaticResource CardStyle}"
                Visibility="{Binding IsReleasePackagingAuthorized, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.GroupAdvancedTitle}" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock
                        Margin="0,0,0,10"
                        Text="{DynamicResource Settings.GroupAdvancedDesc}"
                        Style="{StaticResource MutedTextStyle}"
                        TextWrapping="Wrap" />

                    <TextBlock Text="{DynamicResource Settings.ReleasePackagingSection}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Margin="0,8,0,0" Text="{DynamicResource Settings.ReleasePackagingPublishDirLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox
                        Margin="0,0,0,8"
                        Text="{Binding ReleasePackagingPublishDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{DynamicResource Settings.ReleasePackagingOutputDirLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox
                        Margin="0,0,0,8"
                        Text="{Binding ReleasePackagingOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{DynamicResource Settings.ReleasePackagingNotesLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox
                        Margin="0,0,0,8"
                        MinHeight="68"
                        AcceptsReturn="True"
                        Text="{Binding ReleasePackagingNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button
                            Margin="0,0,6,0"
                            Padding="10,5"
                            Command="{Binding GenerateReleasePackageCommand}"
                            Content="{DynamicResource Settings.ReleasePackagingGenerateButton}"
                            Style="{StaticResource NeutralButtonStyle}" />
                        <Button
                            Padding="10,5"
                            Command="{Binding OpenReleasePackageOutputDirectoryCommand}"
                            Content="{DynamicResource Settings.ReleasePackagingOpenOutputButton}"
                            Style="{StaticResource NeutralButtonStyle}" />
                    </StackPanel>

                    <TextBlock Text="{DynamicResource Settings.ReleasePackagingDesc}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding ReleasePackagingStatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
