<UserControl
    x:Class="SlurmJobManager.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:SlurmJobManager.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800" d:DesignWidth="700"
    Background="{DynamicResource BgBaseBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Margin="24,20,24,20">

            <!-- Page title -->
            <TextBlock Text="{DynamicResource Settings.Title}"
                       Style="{StaticResource PageTitleStyle}" />

            <!-- ── Connection Configuration ─────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.SshConnection}"
                               Style="{StaticResource SectionHeaderStyle}" />
                    <views:ConnectionView DataContext="{Binding Connection}" />
                </StackPanel>
            </Border>

            <!-- ── Theme ────────────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Appearance}"
                               Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{DynamicResource Settings.Theme}"
                                   Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Button Content="{Binding ThemeLabel}"
                                Command="{Binding ToggleThemeCommand}"
                                Style="{StaticResource NeutralButtonStyle}"
                                Padding="12,6" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Settings.ThemeDesc}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ── Language ─────────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Language}"
                               Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource Settings.LanguageLabel}"
                                   Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Button Content="{DynamicResource Settings.LangZhCN}"
                                Command="{Binding SwitchLocaleCommand}"
                                CommandParameter="zh-CN"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="10,5" Margin="0,0,6,0" />
                        <Button Content="{DynamicResource Settings.LangEnUS}"
                                Command="{Binding SwitchLocaleCommand}"
                                CommandParameter="en-US"
                                Style="{StaticResource NeutralButtonStyle}"
                                Padding="10,5" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Polling & Performance ────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.PollingPerf}"
                               Style="{StaticResource SectionHeaderStyle}" />

                    <!-- Poll interval -->
                    <TextBlock Text="{DynamicResource Settings.PollIntervalLabel}"
                               Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Slider Minimum="2" Maximum="60"
                                Value="{Binding PollIntervalSeconds, Mode=TwoWay}"
                                Width="200" VerticalAlignment="Center"
                                Margin="0,0,10,0" />
                        <TextBlock Text="{Binding PollIntervalSeconds}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   MinWidth="28" />
                        <TextBlock Text="s"
                                   Style="{StaticResource MutedTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Settings.PollIntervalDesc}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ── About ─────────────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.About}"
                               Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="{DynamicResource Settings.AppName}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="14"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource Settings.AppDesc}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
