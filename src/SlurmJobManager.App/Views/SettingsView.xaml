<UserControl
    x:Class="SlurmJobManager.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:SlurmJobManager.App.Behaviors"
    xmlns:views="clr-namespace:SlurmJobManager.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800" d:DesignWidth="700"
    Background="{DynamicResource BgBaseBrush}">
    <UserControl.Resources>
        <Style x:Key="LocaleZhButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentLocale}" Value="zh-CN">
                    <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LocaleEnButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentLocale}" Value="en-US">
                    <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                  b:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="24,20,24,20">

            <!-- Page title -->
            <TextBlock Text="{DynamicResource Settings.Title}"
                       Style="{StaticResource PageTitleStyle}" />

            <!-- ── Connection Configuration ─────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.SshConnection}"
                               Style="{StaticResource SectionHeaderStyle}" />
                    <views:ConnectionView DataContext="{Binding Connection}" />
                </StackPanel>
            </Border>

            <!-- ── Startup Behavior ──────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.StartupBehavior}"
                               Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox x:Name="AutoConnectCheckBox"
                                  IsChecked="{Binding AutoConnectOnStartup, Mode=TwoWay}"
                                  Margin="0,0,10,0" />
                        <Label Target="{Binding ElementName=AutoConnectCheckBox}"
                               Content="{DynamicResource Settings.AutoConnectLabel}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Cursor="Hand"
                               Padding="0" />
                    </StackPanel>
                     <TextBlock Text="{DynamicResource Settings.AutoConnectDesc}"
                                Style="{StaticResource MutedTextStyle}"
                                TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource Settings.AutoConnectEffect}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource Settings.AutoSaveHint}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ── Theme ────────────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Appearance}"
                               Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{DynamicResource Settings.Theme}"
                                   Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Button Content="{Binding ThemeLabel}"
                                Command="{Binding ToggleThemeCommand}"
                                Style="{StaticResource NeutralButtonStyle}"
                                Padding="12,6" />
                    </StackPanel>
                     <TextBlock Text="{DynamicResource Settings.ThemeDesc}"
                                Style="{StaticResource MutedTextStyle}"
                                TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource Settings.ThemeEffect}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ── Language ─────────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Language}"
                               Style="{StaticResource SectionHeaderStyle}" />

                     <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource Settings.LanguageLabel}"
                                   Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Button Content="{DynamicResource Settings.LangZhCN}"
                                Command="{Binding SwitchLocaleCommand}"
                                CommandParameter="zh-CN"
                                Style="{StaticResource LocaleZhButtonStyle}"
                                Padding="10,5" Margin="0,0,6,0" />
                        <Button Content="{DynamicResource Settings.LangEnUS}"
                                Command="{Binding SwitchLocaleCommand}"
                                CommandParameter="en-US"
                                 Style="{StaticResource LocaleEnButtonStyle}"
                                 Padding="10,5" />
                     </StackPanel>
                    <Border Background="{DynamicResource BgPanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,6">
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="{DynamicResource Settings.CurrentLanguage}" />
                            <Run Text="{Binding CurrentLocaleDisplayName, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{DynamicResource Settings.LanguageEffect}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ── Polling & Performance ────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.PollingPerf}"
                               Style="{StaticResource SectionHeaderStyle}" />

                    <!-- Poll interval -->
                    <TextBlock Text="{DynamicResource Settings.PollIntervalLabel}"
                               Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Slider Minimum="2" Maximum="60"
                                Value="{Binding PollIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="200" VerticalAlignment="Center"
                                Margin="0,0,10,0" />
                        <TextBlock Text="{Binding PollIntervalSeconds}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   MinWidth="28" />
                        <TextBlock Text="{DynamicResource Units.SecondShort}"
                                    Style="{StaticResource MutedTextStyle}"
                                    VerticalAlignment="Center" />
                    </StackPanel>
                     <TextBlock Text="{DynamicResource Settings.PollIntervalDesc}"
                                Style="{StaticResource MutedTextStyle}"
                                TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource Settings.PollIntervalEffect}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource Settings.HistoryQueryRangeDesc}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ── Local Data ─────────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.LocalData}"
                               Style="{StaticResource SectionHeaderStyle}" />

                    <TextBlock Text="{DynamicResource Settings.LocalDataRootLabel}"
                               Style="{StaticResource FieldLabelStyle}" />

                    <TextBox Text="{Binding LocalDataDirectory, Mode=OneWay}"
                             IsReadOnly="True"
                             Margin="0,0,0,8"
                             ToolTip="{Binding LocalDataDirectory}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{DynamicResource Settings.OpenDataDirectory}"
                                Command="{Binding OpenDataDirectoryCommand}"
                                Style="{StaticResource NeutralButtonStyle}"
                                Padding="10,5"
                                Margin="0,0,6,0" />
                        <Button Content="{DynamicResource Settings.CopyDataDirectory}"
                                Command="{Binding CopyDataDirectoryCommand}"
                                Style="{StaticResource NeutralButtonStyle}"
                                Padding="10,5" />
                    </StackPanel>

                    <TextBlock Text="{DynamicResource Settings.LocalDataDesc}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               ToolTip="{Binding TasksDirectory}">
                        <Run Text="• " />
                        <Run Text="{DynamicResource Settings.LocalDataTasks}" />
                        <Run Text="{Binding TasksDirectory}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               ToolTip="{Binding BlueprintsDirectory}">
                        <Run Text="• " />
                        <Run Text="{DynamicResource Settings.LocalDataBlueprints}" />
                        <Run Text="{Binding BlueprintsDirectory}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               ToolTip="{Binding RecentConnectionsFilePath}">
                        <Run Text="• " />
                        <Run Text="{DynamicResource Settings.LocalDataRecentConnections}" />
                        <Run Text="{Binding RecentConnectionsFilePath}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               ToolTip="{Binding PreferencesFilePath}">
                        <Run Text="• " />
                        <Run Text="{DynamicResource Settings.LocalDataPreferences}" />
                        <Run Text="{Binding PreferencesFilePath}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ── About ─────────────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.About}"
                               Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="{DynamicResource Settings.AppName}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="14"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource Settings.AppDesc}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
