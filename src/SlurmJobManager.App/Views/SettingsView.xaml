<UserControl
    x:Class="SlurmJobManager.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:SlurmJobManager.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800" d:DesignWidth="700"
    Background="{DynamicResource BgBaseBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Margin="24,20,24,20">

            <!-- Page title -->
            <TextBlock Text="Settings"
                       Style="{StaticResource PageTitleStyle}" />

            <!-- ── Connection Configuration ─────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="SSH Connection"
                               Style="{StaticResource SectionHeaderStyle}" />
                    <views:ConnectionView DataContext="{Binding Connection}" />
                </StackPanel>
            </Border>

            <!-- ── Theme ────────────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance"
                               Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Theme:"
                                   Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Button Content="{Binding ThemeLabel}"
                                Command="{Binding ToggleThemeCommand}"
                                Style="{StaticResource NeutralButtonStyle}"
                                Padding="12,6" />
                    </StackPanel>
                    <TextBlock Text="Switch between dark (Catppuccin Mocha) and light (Catppuccin Latte) themes."
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ── Polling & Performance ────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Polling &amp; Performance"
                               Style="{StaticResource SectionHeaderStyle}" />

                    <!-- Poll interval -->
                    <TextBlock Text="Monitor poll interval (seconds)"
                               Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Slider Minimum="2" Maximum="60"
                                Value="{Binding PollIntervalSeconds, Mode=TwoWay}"
                                Width="200" VerticalAlignment="Center"
                                Margin="0,0,10,0" />
                        <TextBlock Text="{Binding PollIntervalSeconds}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   MinWidth="28" />
                        <TextBlock Text="s"
                                   Style="{StaticResource MutedTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="How often the monitor polls squeue. Lower values give faster updates but increase SSH load."
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ── About ─────────────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="About"
                               Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="Slurm Job Manager"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="14"
                               Margin="0,0,0,4" />
                    <TextBlock Text="A modern WPF application for submitting, monitoring, and debugging Slurm HPC jobs over SSH."
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
