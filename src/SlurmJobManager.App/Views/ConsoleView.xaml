<UserControl
    x:Class="SlurmJobManager.App.Views.ConsoleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SlurmJobManager.App.Controls"
    xmlns:conv="clr-namespace:SlurmJobManager.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="420"
    Background="{DynamicResource BgBaseBrush}">

    <UserControl.Resources>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>

    <DockPanel Margin="8">
        <TextBlock
            DockPanel.Dock="Top"
            Text="{DynamicResource Console.Title}"
            Style="{StaticResource PageTitleStyle}" />
        <TextBlock
            DockPanel.Dock="Top"
            Text="{Binding ConsoleStatusSummary}"
            Style="{StaticResource MutedTextStyle}"
            Margin="0,2,0,6" />

        <Border
            DockPanel.Dock="Top"
            Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource AccentYellowBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,6"
            Visibility="{Binding IsConnected, Converter={StaticResource InvBoolToVis}}">
            <TextBlock
                Text="{DynamicResource Console.NotConnected}"
                Foreground="{DynamicResource AccentYellowBrush}"
                FontSize="12" />
        </Border>

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="{Binding PromptText}"
                Foreground="{DynamicResource AccentGreenBrush}"
                FontFamily="Cascadia Mono"
                VerticalAlignment="Center"
                Margin="0,0,8,0" />
            <TextBox
                x:Name="CmdInput"
                Grid.Column="1"
                Text="{Binding CommandInput, UpdateSourceTrigger=PropertyChanged}"
                Foreground="{DynamicResource AccentGreenBrush}"
                FontFamily="Cascadia Mono"
                KeyDown="CmdInput_KeyDown" />
            <Button
                Grid.Column="2"
                Content="{DynamicResource Btn.Run}"
                Command="{Binding ExecuteCommand}"
                Style="{StaticResource SuccessButtonStyle}"
                Margin="4,0,0,0"
                Padding="10,4" />
            <Button
                Grid.Column="3"
                Content="{DynamicResource Btn.StopCmd}"
                Command="{Binding CancelCommand}"
                Style="{StaticResource DangerButtonStyle}"
                Margin="4,0,0,0"
                Padding="8,4" />
            <Button
                Grid.Column="4"
                Content="{DynamicResource Btn.ResetTerminal}"
                Command="{Binding ResetSessionCommand}"
                Style="{StaticResource NeutralButtonStyle}"
                Margin="4,0,0,0"
                Padding="8,4" />
            <Button
                Grid.Column="5"
                Content="{DynamicResource Btn.Copy}"
                Style="{StaticResource AccentButtonStyle}"
                Click="CopyTerminal_Click"
                Margin="4,0,0,0"
                Padding="8,4" />
            <Button
                Grid.Column="6"
                Content="{DynamicResource Btn.Clear}"
                Command="{Binding ClearCommand}"
                Style="{StaticResource NeutralButtonStyle}"
                Margin="4,0,0,0"
                Padding="8,4" />
        </Grid>

        <Border
            Background="{DynamicResource BgCrustBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="2">
            <controls:TerminalSurfaceControl
                x:Name="TerminalSurface"
                InputGenerated="TerminalSurface_InputGenerated"
                TerminalResized="TerminalSurface_TerminalResized" />
        </Border>
    </DockPanel>
</UserControl>
