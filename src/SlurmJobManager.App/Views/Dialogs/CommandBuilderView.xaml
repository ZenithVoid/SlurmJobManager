<Window
    x:Class="SlurmJobManager.App.Views.Dialogs.CommandBuilderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:SlurmJobManager.App.Behaviors"
    xmlns:vm="clr-namespace:SlurmJobManager.App.ViewModels"
    xmlns:conv="clr-namespace:SlurmJobManager.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{DynamicResource CmdBuilder.Title}"
    Height="580" Width="820"
    MinHeight="420" MinWidth="640"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource BgBaseBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Main two-panel layout ───────────────────────────────────── -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: available programs + available param files ───── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Available programs -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,4" Padding="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource CmdBuilder.AvailablePrograms}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <TextBox DockPanel.Dock="Top"
                                 Text="{Binding ProgramFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4"
                                 FontSize="11"
                                 ToolTip="{DynamicResource CmdBuilder.FilterHint}" />
                        <ListBox ItemsSource="{Binding FilteredPrograms}"
                                 SelectedItem="{Binding SelectedProgram, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas" FontSize="11">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Available param files -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,4,0,0" Padding="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource CmdBuilder.AvailableParamFiles}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <TextBox DockPanel.Dock="Top"
                                 Text="{Binding ParamFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4"
                                 FontSize="11"
                                 ToolTip="{DynamicResource CmdBuilder.FilterHint}" />
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" LastChildFill="False">
                            <Button Content="{DynamicResource CmdBuilder.AddParam}"
                                    Command="{Binding AddParamFileCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="8,3" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding FilteredParamFiles}"
                                 SelectedItem="{Binding SelectedAvailableParamFile, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas" FontSize="11">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ── Splitter ──────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BgPanelBrush}" />

            <!-- ── RIGHT: chosen program + chosen param files + preview ─ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="120" />
                </Grid.RowDefinitions>

                <!-- Selected program display -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,4" Padding="6">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CmdBuilder.SelectedProgram}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <TextBox Text="{Binding SelectedProgram, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="11"
                                 ToolTip="{DynamicResource CmdBuilder.ProgramPathHint}" />
                    </StackPanel>
                </Border>

                <!-- Chosen parameter files -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,4" Padding="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource CmdBuilder.ChosenParamFiles}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource CmdBuilder.DoubleClickHint}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="10" Margin="0,0,0,4" />
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" LastChildFill="False">
                            <Button Content="{DynamicResource CmdBuilder.RemoveParam}"
                                    Command="{Binding RemoveParamFileCommand}"
                                    CommandParameter="{Binding SelectedChosenParamFile}"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Padding="8,3" />
                        </DockPanel>
                        <ListBox x:Name="ChosenParamList"
                                 ItemsSource="{Binding ChosenParamFiles}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas" FontSize="11"
                                 MouseDoubleClick="ChosenParamList_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ParameterFileEntryViewModel}">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding FilePath}">
                                        <TextBlock Text="{Binding Alias}"
                                                   Foreground="{DynamicResource AccentGreenBrush}"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding FilePath}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Command preview label -->
                <TextBlock Grid.Row="2"
                           Text="{DynamicResource CmdBuilder.CommandPreview}"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0,0,0,2" />

                <!-- Command preview text -->
                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="6">
                    <TextBox Text="{Binding CommandPreview, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11"
                             Background="Transparent"
                             BorderThickness="0"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Foreground="{DynamicResource AccentYellowBrush}" />
                </Border>
            </Grid>
        </Grid>

        <!-- ── Status message ──────────────────────────────────────────── -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource StatusTextStyle}"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap" />

        <!-- ── Bottom buttons ──────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="{DynamicResource CmdBuilder.Refresh}"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="10,5" />

            <Button Grid.Column="2"
                    Content="{DynamicResource CmdBuilder.Test}"
                    Command="{Binding TestCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="10,5" Margin="0,0,8,0" />

            <Button Grid.Column="3"
                    Content="{DynamicResource CmdBuilder.Confirm}"
                    Command="{Binding ConfirmCommand}"
                    Style="{StaticResource SuccessButtonStyle}"
                    Padding="14,5" Margin="0,0,8,0"
                    Click="BtnConfirm_Click" />

            <Button Grid.Column="4"
                    Content="{DynamicResource CmdBuilder.Cancel}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="10,5"
                    Click="BtnCancel_Click" />
        </Grid>
    </Grid>
</Window>
