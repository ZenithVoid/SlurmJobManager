<Window
    x:Class="SlurmJobManager.App.Views.Dialogs.CommandBuilderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:SlurmJobManager.App.Behaviors"
    xmlns:vm="clr-namespace:SlurmJobManager.App.ViewModels"
    xmlns:conv="clr-namespace:SlurmJobManager.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{DynamicResource CmdBuilder.Title}"
    Height="820" Width="1280"
    MinHeight="560" MinWidth="900"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="False"
    ResizeMode="CanResize"
    Background="{DynamicResource BgBaseBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- WindowChrome: enables resize + custom caption without AllowsTransparency -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="36"
            ResizeBorderThickness="5"
            GlassFrameThickness="0,0,0,1"
            CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom title bar -->
            <RowDefinition Height="36" />
            <!-- Main content -->
            <RowDefinition Height="*" />
            <!-- Status bar -->
            <RowDefinition Height="Auto" />
            <!-- Bottom buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Custom title bar ──────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Border x:Name="TitleBarDragArea"
                        Background="Transparent"
                        HorizontalAlignment="Stretch"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

                <TextBlock Text="{DynamicResource CmdBuilder.Title}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="SemiBold"
                           IsHitTestVisible="False" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button x:Name="BtnMinimize"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="{DynamicResource TitleBar.Minimize}"
                            Click="BtnMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="BtnMaximize"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="{DynamicResource TitleBar.Maximize}"
                            Click="BtnMaximize_Click">
                        <TextBlock x:Name="MaximizeIcon"
                                   Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="BtnClose"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            ToolTip="{DynamicResource TitleBar.Close}"
                            Click="BtnClose_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main content: three columns ──────────────────────────── -->
        <Grid Grid.Row="1" Margin="8,6,8,0">
            <Grid.ColumnDefinitions>
                <!-- Left: file browser (programs + params) -->
                <ColumnDefinition Width="280" MinWidth="180" />
                <ColumnDefinition Width="6" />
                <!-- Centre: command list + detail editor -->
                <ColumnDefinition Width="*" MinWidth="340" />
                <ColumnDefinition Width="6" />
                <!-- Right: sbatch editor -->
                <ColumnDefinition Width="360" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: file browser ───────────────────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Available programs -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource CmdBuilder.AvailablePrograms}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                         <TextBox DockPanel.Dock="Top"
                                  Text="{Binding ProgramFilter, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,4" FontSize="11"
                                  ToolTip="{DynamicResource CmdBuilder.FilterHint}" />
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" LastChildFill="False">
                            <Button Content="{DynamicResource CmdBuilder.ApplyProgram}"
                                    Command="{Binding ApplySelectedProgramCommand}"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Padding="8,3" FontSize="11" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding FilteredPrograms}"
                                 SelectedItem="{Binding SelectedAvailableProgram, Mode=TwoWay}"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  FontFamily="Consolas" FontSize="11"
                                  MouseDoubleClick="ProgramList_DoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Available param files -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource CmdBuilder.AvailableParamFiles}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <TextBox DockPanel.Dock="Top"
                                 Text="{Binding ParamFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4" FontSize="11"
                                 ToolTip="{DynamicResource CmdBuilder.FilterHint}" />
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" LastChildFill="False">
                            <Button Content="{DynamicResource CmdBuilder.AddParam}"
                                    Command="{Binding AddParamFileCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="8,3" FontSize="11" Margin="0,0,4,0" />
                            <Button Content="{DynamicResource CmdBuilder.NewParam}"
                                    Command="{Binding CreateParamFileCommand}"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Padding="8,3" FontSize="11" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding FilteredParamFiles}"
                                 SelectedItem="{Binding SelectedAvailableParamFile, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas" FontSize="11">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BgPanelBrush}" />

            <!-- ── CENTRE: command list + detail ────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="220" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Command list with Add/Remove/Order -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource CmdBuilder.CommandList}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                    Margin="0,4,0,0" HorizontalAlignment="Left">
                            <Button Content="{DynamicResource CmdBuilder.AddCmd}"
                                    Command="{Binding AddCommandCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="8,3" Margin="0,0,4,0" FontSize="11" />
                            <Button Content="{DynamicResource CmdBuilder.RemoveCmd}"
                                    Command="{Binding RemoveCommandCommand}"
                                    CommandParameter="{Binding SelectedCommand}"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Padding="8,3" Margin="0,0,4,0" FontSize="11" />
                            <Button Content="▲"
                                    Command="{Binding MoveUpCommand}"
                                    CommandParameter="{Binding SelectedCommand}"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Padding="8,3" Margin="0,0,4,0" FontSize="11"
                                    ToolTip="{DynamicResource CmdBuilder.MoveUp}" />
                            <Button Content="▼"
                                    Command="{Binding MoveDownCommand}"
                                    CommandParameter="{Binding SelectedCommand}"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Padding="8,3" FontSize="11"
                                    ToolTip="{DynamicResource CmdBuilder.MoveDown}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Commands}"
                                 SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 MaxHeight="240"
                                 FontFamily="Consolas" FontSize="11">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CommandEntryViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Order}" Width="22"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding DisplaySummary}"
                                                   Foreground="{DynamicResource AccentYellowBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Selected command detail editor -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  b:SmoothScrollBehavior.IsEnabled="True"
                                  b:SmoothScrollBehavior.ScrollAmount="40">
                        <StackPanel IsEnabled="{Binding HasSelectedCommand}">

                            <!-- Program path -->
                            <TextBlock Text="{DynamicResource CmdBuilder.SelectedProgram}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                          Text="{Binding SelectedCommand.ProgramPath, UpdateSourceTrigger=PropertyChanged}"
                                          FontFamily="Consolas" FontSize="11"
                                          MinWidth="0"
                                          HorizontalAlignment="Stretch"
                                          ToolTip="{Binding SelectedCommand.ProgramPath}"
                                          />
                                <Button Grid.Column="1"
                                        Content="..."
                                        Command="{Binding BrowseProgramPathCommand}"
                                        Style="{StaticResource NeutralButtonStyle}"
                                        Margin="4,0,0,0" Padding="8,4"
                                        ToolTip="{DynamicResource CmdBuilder.BrowseProgramPath}" />
                            </Grid>

                            <!-- MPI path row -->
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource CmdBuilder.MpirunPath}"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding SelectedCommand.MpirunPath, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" FontSize="11"
                                             ToolTip="{DynamicResource CmdBuilder.MpirunHint}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{DynamicResource CmdBuilder.DetectMpi}"
                                        Command="{Binding DetectMpiCommand}"
                                        Style="{StaticResource NeutralButtonStyle}"
                                        Padding="8,4" Margin="4,18,0,0" FontSize="11"
                                        VerticalAlignment="Bottom"
                                        ToolTip="{DynamicResource CmdBuilder.DetectMpiTooltip}" />
                            </Grid>

                            <!-- Attached parameter files -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource CmdBuilder.ChosenParamFiles}"
                                           Style="{StaticResource SectionHeaderStyle}" />
                                <Button Grid.Column="1"
                                        Content="..."
                                        Command="{Binding BrowseParamFileCommand}"
                                        Style="{StaticResource NeutralButtonStyle}"
                                        Padding="8,3"
                                        ToolTip="{DynamicResource CmdBuilder.BrowseParamFile}" />
                            </Grid>
                            <TextBlock Text="{DynamicResource CmdBuilder.DoubleClickHint}"
                                       Style="{StaticResource MutedTextStyle}"
                                       FontSize="10" Margin="0,0,0,2" />
                            <ListBox x:Name="ChosenParamList"
                                     ItemsSource="{Binding SelectedCommand.ParameterFiles}"
                                     MaxHeight="90"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     FontFamily="Consolas" FontSize="11"
                                     MouseDoubleClick="ChosenParamList_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4,2" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <Button Content="{DynamicResource CmdBuilder.RemoveParam}"
                                    Command="{Binding RemoveParamFileCommand}"
                                    CommandParameter="{Binding ElementName=ChosenParamList, Path=SelectedItem}"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Padding="8,3" Margin="0,2,0,6"
                                    HorizontalAlignment="Left" FontSize="11" />

                            <!-- Extra args -->
                            <TextBlock Text="{DynamicResource CmdBuilder.ExtraArgs}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{DynamicResource CmdBuilder.ExtraArgsHint}"
                                       Style="{StaticResource MutedTextStyle}"
                                       FontSize="10" Margin="0,0,0,2" />
                            <ItemsControl ItemsSource="{Binding SelectedCommand.ExtraArgs}"
                                          Margin="0,0,0,2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ExtraArgViewModel}">
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Arg, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="Consolas" FontSize="11" />
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Command="{Binding DataContext.RemoveExtraArgCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource NeutralButtonStyle}"
                                                    Padding="6,2" Margin="4,0,0,0" FontSize="10" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{DynamicResource CmdBuilder.AddExtraArg}"
                                    Command="{Binding AddExtraArgCommand}"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Padding="8,3" HorizontalAlignment="Left" FontSize="11" />

                            <!-- Command preview -->
                            <TextBlock Text="{DynamicResource CmdBuilder.CommandPreview}"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0,8,0,2" />
                            <Border Style="{StaticResource CardStyle}" Padding="6" Margin="0,0,0,2"
                                    Background="{DynamicResource BgCrustBrush}">
                                <TextBox Text="{Binding SelectedCommand.CommandLine, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="11"
                                         Background="Transparent" BorderThickness="0"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="52" VerticalScrollBarVisibility="Auto"
                                         Foreground="{DynamicResource AccentYellowBrush}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BgPanelBrush}" />

            <!-- ── RIGHT: sbatch editor ──────────────────────────────── -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                 Margin="0,4,0,0" HorizontalAlignment="Left">
                        <Button Content="{DynamicResource CmdBuilder.RegenSbatch}"
                                Click="BtnRegenSbatch_Click"
                                Style="{StaticResource NeutralButtonStyle}"
                                Padding="8,3" FontSize="11" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  b:SmoothScrollBehavior.IsEnabled="True"
                                  b:SmoothScrollBehavior.ScrollAmount="40">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource CmdBuilder.SbatchJobConfig}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{DynamicResource CmdBuilder.SbatchJobConfigHint}"
                                       Style="{StaticResource MutedTextStyle}"
                                       FontSize="10" Margin="0,0,0,4"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{DynamicResource CmdBuilder.SbatchJobName}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding SbatchJobName, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" FontSize="11" Margin="0,0,0,4" />

                            <TextBlock Text="{DynamicResource CmdBuilder.SbatchQueue}" Style="{StaticResource FieldLabelStyle}" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                           ItemsSource="{Binding AvailableQueues}"
                                           SelectedItem="{Binding SbatchPartition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           MinHeight="32"
                                           VerticalContentAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentBlueBrush}"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="i"
                                            Visibility="{Binding HasSelectedQueueMetadata, Converter={StaticResource BoolToVis}}">
                                    <TextBlock.ToolTip>
                                        <ToolTip Style="{StaticResource AppToolTipStyle}">
                                            <TextBlock Text="{Binding SelectedQueueMetadataSummary}"
                                                       FontFamily="Segoe UI"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                        TextWrapping="Wrap" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </Grid>

                            <TextBlock Text="{DynamicResource CmdBuilder.SbatchNodes}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding SbatchNodes, UpdateSourceTrigger=PropertyChanged}"
                                     b:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                                     FontFamily="Consolas" FontSize="11" Margin="0,0,0,4" />

                            <TextBlock Text="{DynamicResource CmdBuilder.SbatchTaskCount}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding SbatchTaskCount, UpdateSourceTrigger=PropertyChanged}"
                                     b:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                                     FontFamily="Consolas" FontSize="11" Margin="0,0,0,4" />

                            <TextBlock Text="{DynamicResource CmdBuilder.SbatchCpuCount}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding SbatchCpuCount, UpdateSourceTrigger=PropertyChanged}"
                                     b:DigitsOnlyTextBoxBehavior.IsEnabled="True"
                                     FontFamily="Consolas" FontSize="11" Margin="0,0,0,4" />

                            <TextBlock Text="{DynamicResource CmdBuilder.SbatchTimeLimit}" Style="{StaticResource FieldLabelStyle}" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding SbatchTimeYearOptions}"
                                          SelectedItem="{Binding SbatchTimeYears, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          FontFamily="Consolas"
                                          FontSize="11"
                                          MinHeight="32"
                                          VerticalContentAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource CmdBuilder.SbatchTimeYears}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,8,0"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding SbatchTimeMonthOptions}"
                                          SelectedItem="{Binding SbatchTimeMonths, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          FontFamily="Consolas"
                                          FontSize="11"
                                          MinHeight="32"
                                          VerticalContentAlignment="Center" />
                                <TextBlock Grid.Column="3"
                                           Text="{DynamicResource CmdBuilder.SbatchTimeMonths}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,8,0"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Grid.Column="4"
                                          ItemsSource="{Binding SbatchTimeDayOptions}"
                                          SelectedItem="{Binding SbatchTimeDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          FontFamily="Consolas"
                                          FontSize="11"
                                          MinHeight="32"
                                          VerticalContentAlignment="Center" />
                                <TextBlock Grid.Column="5"
                                           Text="{DynamicResource CmdBuilder.SbatchTimeDays}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"
                                           Style="{StaticResource FieldLabelStyle}" />
                            </Grid>

                            <TextBlock Text="{DynamicResource CmdBuilder.SbatchAccount}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding SbatchAccount, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" FontSize="11" Margin="0,0,0,4" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource CmdBuilder.SbatchExclusive}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0" />
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding SbatchExclusive, Mode=TwoWay}"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="{DynamicResource CmdBuilder.SbatchScript}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{DynamicResource CmdBuilder.SbatchHint}"
                                       Style="{StaticResource MutedTextStyle}"
                                       FontSize="10" Margin="0,0,0,4"
                                       TextWrapping="Wrap" />
                            <TextBox Text="{Binding SbatchContent, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" FontSize="11"
                                     Background="{DynamicResource BgCrustBrush}"
                                     Foreground="{DynamicResource AccentGreenBrush}"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     MinHeight="260"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Padding="6,4" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ── Status bar ────────────────────────────────────────────── -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource StatusTextStyle}"
                   Margin="8,4,8,0"
                   TextWrapping="Wrap" />

        <!-- ── Bottom buttons ─────────────────────────────────────────── -->
        <Grid Grid.Row="3" Margin="8,6,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="{DynamicResource CmdBuilder.Refresh}"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="10,5" />

            <Button Grid.Column="2"
                    Content="{DynamicResource CmdBuilder.Test}"
                    Command="{Binding TestCommandCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="10,5" Margin="0,0,8,0" />

            <Button Grid.Column="3"
                    Content="{DynamicResource CmdBuilder.SaveApply}"
                    Click="BtnSaveApply_Click"
                    Style="{StaticResource SuccessButtonStyle}"
                    Padding="14,5" Margin="0,0,8,0" />

            <Button Grid.Column="4"
                    Content="{DynamicResource CmdBuilder.Cancel}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="10,5"
                    Click="BtnCancel_Click" />
        </Grid>
    </Grid>
</Window>
