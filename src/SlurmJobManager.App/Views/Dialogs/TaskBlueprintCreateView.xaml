<Window
    x:Class="SlurmJobManager.App.Views.Dialogs.TaskBlueprintCreateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SlurmJobManager.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    mc:Ignorable="d"
    Title="{DynamicResource Task.BlueprintManagerTitle}"
    Width="900"
    Height="620"
    MinWidth="800"
    MinHeight="520"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="False"
    ResizeMode="CanResize"
    Background="{DynamicResource BgBaseBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="36"
            ResizeBorderThickness="5"
            GlassFrameThickness="0,0,0,1"
            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:StyleKeyToStyleConverter x:Key="StyleKeyToStyle" />
        <Style x:Key="BlueprintListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource BgCrustBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style x:Key="BlueprintListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSurface0Brush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BgSurface1Brush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSurface1Brush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BlueprintPreviewValueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Border Background="Transparent"
                        HorizontalAlignment="Stretch"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
                <TextBlock Text="{DynamicResource Task.BlueprintManagerTitle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           IsHitTestVisible="False" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button x:Name="BtnMinimize"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="{DynamicResource TitleBar.Minimize}"
                            Click="BtnMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="BtnMaximize"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="{DynamicResource TitleBar.Maximize}"
                            Click="BtnMaximize_Click">
                        <TextBlock x:Name="MaximizeIcon"
                                   Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="BtnClose"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            ToolTip="{DynamicResource TitleBar.Close}"
                            Click="BtnClose_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left"
                       Text="{DynamicResource Task.BlueprintManagerTitle}"
                       Style="{StaticResource SectionHeaderStyle}" />
            <Button DockPanel.Dock="Right"
                    Content="{DynamicResource Btn.Refresh}"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="10,4" />
            <TextBox Width="280"
                     Margin="8,0,8,0"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource Task.BlueprintSearchHint}" />
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="0"
                Style="{StaticResource CardStyle}"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{DynamicResource Task.BlueprintList}"
                           Style="{StaticResource FieldLabelStyle}" />

                 <ListBox Grid.Row="1"
                          Margin="0,6,0,0"
                          ItemsSource="{Binding FilteredBlueprints}"
                          SelectedItem="{Binding SelectedBlueprint, Mode=TwoWay}"
                          Style="{StaticResource BlueprintListBoxStyle}"
                          ItemContainerStyle="{StaticResource BlueprintListBoxItemStyle}">
                     <ListBox.ItemTemplate>
                         <DataTemplate>
                             <StackPanel Margin="0,2">
                                 <TextBlock Text="{Binding Name}"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}" />
                                 <TextBlock Text="{Binding Description}"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource MutedTextStyle}"
                                            Foreground="{DynamicResource TextSecondaryBrush}" />
                                 <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                            Style="{StaticResource MutedTextStyle}"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            FontSize="11" />
                             </StackPanel>
                         </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2"
                Style="{StaticResource CardStyle}"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{DynamicResource Task.BlueprintPreview}"
                           Style="{StaticResource SectionHeaderStyle}" />

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Task.BlueprintName}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedBlueprintName}" Style="{StaticResource BlueprintPreviewValueTextStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Task.BlueprintDescription}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedBlueprintDescription}" Style="{StaticResource BlueprintPreviewValueTextStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Task.BlueprintUpdatedAt}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedBlueprintUpdatedAt}" Style="{StaticResource BlueprintPreviewValueTextStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Task.BlueprintProgramPath}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PreviewProgramPath}" Style="{StaticResource BlueprintPreviewValueTextStyle}" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Task.BlueprintWorkDirectory}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PreviewWorkDirectory}" Style="{StaticResource BlueprintPreviewValueTextStyle}" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Task.BlueprintJobName}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PreviewJobName}" Style="{StaticResource BlueprintPreviewValueTextStyle}" />
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource Task.BlueprintQueue}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PreviewQueue}" Style="{StaticResource BlueprintPreviewValueTextStyle}" />
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource Task.BlueprintNodes}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PreviewNodes}" Style="{StaticResource BlueprintPreviewValueTextStyle}" />
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource Task.BlueprintCpuCount}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding PreviewCpuCount}" Style="{StaticResource BlueprintPreviewValueTextStyle}" />
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="{DynamicResource Task.BlueprintAccount}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding PreviewAccount}" Style="{StaticResource BlueprintPreviewValueTextStyle}" />
                    <TextBlock Grid.Row="10" Grid.Column="0" Text="{DynamicResource Task.BlueprintParamFiles}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,4" />
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding PreviewParamFileCount}" Style="{StaticResource BlueprintPreviewValueTextStyle}" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                Style="{StaticResource CardStyle}"
                Padding="10"
                Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource Task.BlueprintManageActions}"
                           Style="{StaticResource FieldLabelStyle}" />
                <DockPanel Margin="0,6,0,0">
                    <TextBox Width="280"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource Task.BlueprintName}" />
                    <Button Content="{DynamicResource Task.BlueprintRename}"
                            Command="{Binding RenameBlueprintCommand}"
                            Style="{StaticResource NeutralButtonStyle}"
                            Padding="10,4"
                            Margin="8,0,0,0" />
                    <Button Content="{DynamicResource Task.BlueprintDuplicate}"
                            Command="{Binding DuplicateBlueprintCommand}"
                            Style="{StaticResource NeutralButtonStyle}"
                            Padding="10,4"
                            Margin="8,0,0,0" />
                    <Button Content="{DynamicResource Task.BlueprintDelete}"
                            Command="{Binding DeleteBlueprintCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Padding="10,4"
                            Margin="8,0,0,0" />
                </DockPanel>
                <TextBlock Text="{Binding PreviewParamFileCountText}"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       Margin="0,0,8,0"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Style="{Binding StatusStyleKey, Converter={StaticResource StyleKeyToStyle}}" />

            <Button Grid.Column="1"
                    Content="{DynamicResource Task.BlueprintApplyToCurrent}"
                    Style="{StaticResource SuccessButtonStyle}"
                    Padding="12,5"
                    Margin="0,0,8,0"
                    Click="BtnApply_Click" />
            <Button Grid.Column="2"
                    Content="{DynamicResource Btn.Cancel}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="12,5"
                    Click="BtnCancel_Click" />
        </Grid>
    </Grid>
</Grid>
</Window>
