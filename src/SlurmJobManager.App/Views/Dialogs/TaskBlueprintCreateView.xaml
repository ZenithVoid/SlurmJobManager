<Window
    x:Class="SlurmJobManager.App.Views.Dialogs.TaskBlueprintCreateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{DynamicResource Task.BlueprintCreateTitle}"
    Width="640"
    Height="480"
    MinWidth="580"
    MinHeight="420"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource BgBaseBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="{DynamicResource Task.BlueprintList}"
                   Style="{StaticResource SectionHeaderStyle}" />

        <ListBox Grid.Row="1" Grid.Column="0"
                 ItemsSource="{Binding Blueprints}"
                 SelectedItem="{Binding SelectedBlueprint, Mode=TwoWay}"
                 DisplayMemberPath="Name"
                 Margin="0,6,0,8" />

        <Border Grid.Row="1" Grid.Column="2"
                Style="{StaticResource CardStyle}"
                Padding="8"
                Margin="0,6,0,8">
            <StackPanel>
                <TextBlock Text="{DynamicResource Task.BlueprintDescription}"
                           Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Text="{Binding SelectedBlueprintDescription}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <TextBlock Text="{DynamicResource Task.BlueprintUpdatedAt}"
                           Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Text="{Binding SelectedBlueprintUpdatedAt}"
                           Margin="0,0,0,8" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Task.BlueprintNewTaskId}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBox Width="260"
                     Text="{Binding NewTaskId, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="{DynamicResource Task.BlueprintDelete}"
                    Command="{Binding DeleteBlueprintCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="10,4"
                    Margin="12,0,0,0" />
            <Button Content="{DynamicResource Btn.Refresh}"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="10,4"
                    Margin="8,0,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="{Binding StatusMessage}"
                   Margin="0,8,0,8"
                   TextWrapping="Wrap"
                   Style="{StaticResource WarningTextStyle}" />

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{DynamicResource Task.BlueprintCreateConfirm}"
                    Style="{StaticResource SuccessButtonStyle}"
                    Padding="12,5"
                    Margin="0,0,8,0"
                    Click="BtnCreate_Click" />
            <Button Content="{DynamicResource Btn.Cancel}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="12,5"
                    Click="BtnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
