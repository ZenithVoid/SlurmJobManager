<UserControl
    x:Class="SlurmJobManager.App.Views.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SlurmJobManager.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="400"
    Background="{DynamicResource BgBaseBrush}">

    <UserControl.Resources>
        <conv:JobStateToBrushConverter x:Key="StateToBrush" />
    </UserControl.Resources>

    <DockPanel Margin="12">

        <!-- Top controls -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">

            <!-- Watch user row -->
            <TextBlock Text="Watch User" Style="{StaticResource FieldLabelStyle}" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding WatchedUser, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="4,0,0,0" Padding="8,4" />
                <Button Grid.Column="2" Content="▶ Poll"
                        Command="{Binding StartPollingCommand}"
                        Style="{StaticResource SuccessButtonStyle}"
                        Margin="4,0,0,0" Padding="8,4" />
                <Button Grid.Column="3" Content="■ Stop"
                        Command="{Binding StopPollingCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Margin="4,0,0,0" Padding="8,4" />
            </Grid>

            <!-- Poll interval slider -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Poll interval (s): "
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" />
                <Slider Minimum="2" Maximum="10"
                        Value="{Binding PollIntervalSeconds}"
                        Width="100" VerticalAlignment="Center" Margin="4,0,4,0" />
                <TextBlock Text="{Binding PollIntervalSeconds}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Status filter + keyword search -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Filter: "
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding StatusFilterOptions}"
                          SelectedItem="{Binding StatusFilter}"
                          Margin="0,0,6,0" />
                <TextBlock Grid.Column="2" Text="🔍 "
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="3"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </StackPanel>

        <!-- Bottom: cancel + status -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="Cancel Selected Job"
                    Command="{Binding CancelJobCommand}"
                    Style="{StaticResource DangerButtonStyle}"
                    Padding="8,4"
                    HorizontalAlignment="Left" />
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource StatusTextStyle}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Jobs DataGrid with state-colour rows -->
        <DataGrid ItemsSource="{Binding Jobs}"
                  SelectedItem="{Binding SelectedJob}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground"
                            Value="{Binding State, Converter={StaticResource StateToBrush}}" />
                    <Style.Triggers>
                        <!-- Running pulse animation -->
                        <DataTrigger Binding="{Binding State}" Value="RUNNING">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            From="1.0" To="0.7"
                                            Duration="0:0:1.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Job ID"    Binding="{Binding JobId}"    Width="70" />
                <DataGridTextColumn Header="Name"      Binding="{Binding JobName}"  Width="*" />
                <DataGridTextColumn Header="User"      Binding="{Binding User}"     Width="80" />
                <DataGridTextColumn Header="State"     Binding="{Binding State}"    Width="90" />
                <DataGridTextColumn Header="Partition" Binding="{Binding Partition}" Width="90" />
                <DataGridTextColumn Header="Run Time"  Binding="{Binding RunTime}"  Width="80" />
                <DataGridTextColumn Header="Nodes"     Binding="{Binding NodeList}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
