<UserControl
    x:Class="SlurmJobManager.App.Views.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="400"
    Background="#1E1E2E">

    <DockPanel Margin="12">

        <!-- Top controls -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Watch User" Foreground="#CDD6F4" Margin="0,0,0,2" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding WatchedUser, UpdateSourceTrigger=PropertyChanged}"
                         Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" Padding="6,4" />
                <Button Grid.Column="1" Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Margin="4,0,0,0" Padding="8,4"
                        Background="#89B4FA" Foreground="#1E1E2E"
                        FontWeight="Bold" BorderThickness="0" />
                <Button Grid.Column="2" Content="▶ Poll"
                        Command="{Binding StartPollingCommand}"
                        Margin="4,0,0,0" Padding="8,4"
                        Background="#A6E3A1" Foreground="#1E1E2E"
                        FontWeight="Bold" BorderThickness="0" />
                <Button Grid.Column="3" Content="■ Stop"
                        Command="{Binding StopPollingCommand}"
                        Margin="4,0,0,0" Padding="8,4"
                        Background="#F38BA8" Foreground="#1E1E2E"
                        FontWeight="Bold" BorderThickness="0" />
            </Grid>

            <!-- Poll interval slider -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Poll interval (s): "
                           Foreground="#6C7086" VerticalAlignment="Center" />
                <Slider Minimum="2" Maximum="10"
                        Value="{Binding PollIntervalSeconds}"
                        Width="100" VerticalAlignment="Center" Margin="4,0,4,0" />
                <TextBlock Text="{Binding PollIntervalSeconds}"
                           Foreground="#CDD6F4" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- Bottom: cancel button + status -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="Cancel Selected Job"
                    Command="{Binding CancelJobCommand}"
                    Padding="8,4"
                    Background="#F38BA8" Foreground="#1E1E2E"
                    FontWeight="Bold" BorderThickness="0"
                    HorizontalAlignment="Left" />
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#F9E2AF" FontSize="11"
                       Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Jobs DataGrid with state-colour rows -->
        <DataGrid ItemsSource="{Binding Jobs}"
                  SelectedItem="{Binding SelectedJob}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="#313244" Foreground="#CDD6F4"
                  RowBackground="#313244" AlternatingRowBackground="#2A2A3E"
                  BorderBrush="#45475A" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#45475A"
                  SelectionMode="Single">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#CDD6F4" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="RUNNING">
                            <Setter Property="Foreground" Value="#A6E3A1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="PENDING">
                            <Setter Property="Foreground" Value="#F9E2AF" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="FAILED">
                            <Setter Property="Foreground" Value="#F38BA8" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="CANCELLED">
                            <Setter Property="Foreground" Value="#FAB387" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="TIMEOUT">
                            <Setter Property="Foreground" Value="#FAB387" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="COMPLETED">
                            <Setter Property="Foreground" Value="#89B4FA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Job ID"    Binding="{Binding JobId}"    Width="70" />
                <DataGridTextColumn Header="Name"      Binding="{Binding JobName}"  Width="*" />
                <DataGridTextColumn Header="User"      Binding="{Binding User}"     Width="80" />
                <DataGridTextColumn Header="State"     Binding="{Binding State}"    Width="90" />
                <DataGridTextColumn Header="Partition" Binding="{Binding Partition}" Width="90" />
                <DataGridTextColumn Header="Run Time"  Binding="{Binding RunTime}"  Width="80" />
                <DataGridTextColumn Header="Nodes"     Binding="{Binding NodeList}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
