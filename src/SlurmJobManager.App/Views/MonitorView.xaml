<UserControl x:Name="Root"
    x:Class="SlurmJobManager.App.Views.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:SlurmJobManager.App.Behaviors"
    xmlns:conv="clr-namespace:SlurmJobManager.App.Converters"
    xmlns:shared="clr-namespace:SlurmJobManager.App.Views.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="700" d:DesignWidth="520"
    Background="{DynamicResource BgBaseBrush}">

    <UserControl.Resources>
        <conv:JobStateToBrushConverter x:Key="StateToBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:InverseBoolConverter x:Key="InvBool" />
        <conv:StyleKeyToStyleConverter x:Key="StyleKeyToStyle" />
        <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountToVis" />

        <Style x:Key="CurrentJobsGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentJobs.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryJobsGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HistoryJobs.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CurrentJobsRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Foreground"
                    Value="{Binding State, Converter={StaticResource StateToBrush}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="RUNNING">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="RunningPulseCurrent">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.85"
                                                 Duration="0:0:1.5" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="RunningPulseCurrent" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryJobsRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Foreground"
                    Value="{Binding State, Converter={StaticResource StateToBrush}}" />
        </Style>

        <Style x:Key="TrimmedJobCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MonitorGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="MonitorCompactTextColumnStyle" TargetType="TextBlock" BasedOn="{StaticResource TrimmedJobCellTextStyle}">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Style="{StaticResource PageHeaderCardStyle}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Monitor.Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding MonitorContextSummary}" Style="{StaticResource PageContextSummaryStyle}" />
                <WrapPanel Margin="0,2,0,0">
                    <Border Style="{StaticResource MetricPillStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Monitor.MetricCurrent}" Style="{StaticResource MetricPillLabelStyle}" />
                            <TextBlock Text="{Binding CurrentJobCount}" Style="{StaticResource MetricPillValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricPillStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Monitor.MetricRunning}" Style="{StaticResource MetricPillLabelStyle}" />
                            <TextBlock Text="{Binding RunningJobCount}" Style="{StaticResource MetricPillValueStyle}"
                                       Foreground="{DynamicResource AccentGreenBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricPillStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Monitor.MetricPending}" Style="{StaticResource MetricPillLabelStyle}" />
                            <TextBlock Text="{Binding PendingJobCount}" Style="{StaticResource MetricPillValueStyle}"
                                       Foreground="{DynamicResource AccentYellowBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricPillStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Monitor.MetricAttention}" Style="{StaticResource MetricPillLabelStyle}" />
                            <TextBlock Text="{Binding AttentionJobCount}" Style="{StaticResource MetricPillValueStyle}"
                                       Foreground="{DynamicResource AccentRedBrush}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource Monitor.WatchUser}" Style="{StaticResource FieldLabelStyle}" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding WatchedUser, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding ShowAllUsers, Converter={StaticResource InvBool}}" />

                <CheckBox Grid.Column="1"
                          Content="{DynamicResource Monitor.ViewAll}"
                          IsChecked="{Binding ShowAllUsers}"
                          VerticalAlignment="Center"
                          Margin="6,0,4,0">
                    <CheckBox.ToolTip>
                        <ToolTip Style="{StaticResource AppToolTipStyle}">
                            <TextBlock Text="{DynamicResource Monitor.ViewAllTooltip}" />
                        </ToolTip>
                    </CheckBox.ToolTip>
                </CheckBox>

                <Button Grid.Column="2"
                        Content="{Binding TogglePollingButtonText}"
                        Command="{Binding TogglePollingCommand}"
                        Style="{Binding TogglePollingButtonStyleKey, Converter={StaticResource StyleKeyToStyle}}"
                        Margin="4,0,0,0"
                        Padding="8,4" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{DynamicResource Monitor.PollInterval}"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" />
                <Slider Minimum="2" Maximum="60"
                        Value="{Binding PollIntervalSeconds}"
                        Width="100"
                        VerticalAlignment="Center"
                        Margin="4,0,4,0" />
                <TextBlock Text="{Binding PollIntervalSeconds}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusPanelStyle}">
            <TextBlock Text="{Binding EffectiveStatusMessage}"
                       Style="{Binding EffectiveStatusStyleKey, Converter={StaticResource StyleKeyToStyle}}" />
        </Border>

        <shared:EmptyStateView
            DockPanel.Dock="Top"
            Icon="📊"
            EmptyTitle="{DynamicResource Monitor.EmptyTitle}"
            EmptyHint="{DynamicResource Monitor.EmptyHint}"
            Margin="0,32,0,0"
            Visibility="{Binding IsEmptyState, Converter={StaticResource BoolToVis}}" />

        <TabControl SelectedIndex="{Binding SelectedMonitorTabIndex, Mode=TwoWay}"
                    Visibility="{Binding IsEmptyState, Converter={StaticResource InvBoolToVis}}">
            <TabItem Header="{DynamicResource Monitor.TabCurrentJobs}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Monitor.Filter}"
                                   Style="{StaticResource MutedTextStyle}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding StatusFilter}"
                                  Margin="0,0,6,0" />
                        <TextBlock Grid.Column="2"
                                   Text="🔍 "
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="3"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,6,0" />
                        <Button Grid.Column="4"
                                Content="{DynamicResource Btn.Refresh}"
                                Command="{Binding RefreshCurrentJobsCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="10,4" />
                    </Grid>

                    <ScrollViewer x:Name="CurrentJobsScrollHost"
                                  Grid.Row="1"
                                  Background="{DynamicResource BgSurface0Brush}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  CanContentScroll="False"
                                  b:SmoothScrollBehavior.IsEnabled="True"
                                  b:SmoothScrollBehavior.ScrollAmount="60"
                                  b:MouseWheelRoutingBehavior.IsEnabled="True">
                        <Grid Background="{DynamicResource BgSurface0Brush}"
                              MinWidth="1020"
                              Width="{Binding ElementName=CurrentJobsScrollHost, Path=ViewportWidth}">
                            <shared:EmptyStateView
                                Icon="📭"
                                EmptyTitle="{DynamicResource Monitor.CurrentEmptyTitle}"
                                EmptyHint="{DynamicResource Monitor.CurrentEmptyHint}"
                                Margin="0,18,0,0"
                                Visibility="{Binding CurrentJobs.Count, Converter={StaticResource ZeroCountToVis}}" />
                            <DataGrid ItemsSource="{Binding CurrentJobs}"
                                      SelectedItem="{Binding SelectedCurrentJob}"
                                      Style="{StaticResource CurrentJobsGridStyle}"
                                      RowStyle="{StaticResource CurrentJobsRowStyle}"
                                      CellStyle="{StaticResource MonitorGridCellStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      RowHeight="38"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Monitor.ColJobId}" Binding="{Binding JobId}" Width="90" ElementStyle="{StaticResource MonitorCompactTextColumnStyle}" />

                                <DataGridTemplateColumn Header="{DynamicResource Monitor.ColName}" Width="1.45*" MinWidth="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding JobName}"
                                                       Style="{StaticResource TrimmedJobCellTextStyle}">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Style="{StaticResource AppToolTipStyle}"
                                                             Placement="Mouse"
                                                             ToolTipService.ShowDuration="60000">
                                                        <TextBlock Text="{Binding JobName}"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="480" />
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource Monitor.ColUser}"
                                                        Width="96"
                                                        Visibility="{Binding DataContext.ShowAllUsers, ElementName=Root, Converter={StaticResource BoolToVis}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding User}"
                                                       Style="{StaticResource TrimmedJobCellTextStyle}"
                                                       ToolTip="{Binding User}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>


                                <DataGridTemplateColumn Header="{DynamicResource Monitor.ColState}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding State}"
                                                       Style="{StaticResource TrimmedJobCellTextStyle}"
                                                       ToolTip="{Binding Reason}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource Monitor.ColPartition}" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Partition}"
                                                       Style="{StaticResource TrimmedJobCellTextStyle}"
                                                       ToolTip="{Binding Partition}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{DynamicResource Monitor.ColNodes}" Width="1.5*" MinWidth="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NodeList}"
                                                       Style="{StaticResource TrimmedJobCellTextStyle}"
                                                       ToolTip="{Binding NodeList}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="{DynamicResource Monitor.ColRunTime}" Binding="{Binding RunTimeDisplay}" Width="90" ElementStyle="{StaticResource MonitorCompactTextColumnStyle}" />
                                <DataGridTextColumn Header="{DynamicResource Monitor.ColStartTime}" Binding="{Binding StartTimeDisplay}" Width="170" ElementStyle="{StaticResource MonitorCompactTextColumnStyle}" />

                                <DataGridTemplateColumn Header="{DynamicResource Monitor.ColAction}" Width="102">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{DynamicResource Monitor.ActionCancelJob}"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding CanCancelJob, Converter={StaticResource BoolToVis}}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Command="{Binding DataContext.CancelCurrentJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Monitor.TabHistoryJobs}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                        <Button Content="{DynamicResource Monitor.ActionOpenStdout}"
                                Command="{Binding OpenHistoryStdoutCommand}"
                                CommandParameter="{Binding SelectedHistoryJob}"
                                Style="{StaticResource NeutralButtonStyle}"
                                Margin="0,0,4,0"
                                Padding="8,4" />
                        <Button Content="{DynamicResource Monitor.ActionOpenStderr}"
                                Command="{Binding OpenHistoryStderrCommand}"
                                CommandParameter="{Binding SelectedHistoryJob}"
                                Style="{StaticResource NeutralButtonStyle}"
                                Margin="0,0,4,0"
                                Padding="8,4" />
                        <Button Content="{DynamicResource Monitor.ActionOpenTaskDir}"
                                Command="{Binding OpenHistoryWorkDirCommand}"
                                CommandParameter="{Binding SelectedHistoryJob}"
                                Style="{StaticResource NeutralButtonStyle}"
                                Margin="0,0,4,0"
                                Padding="8,4" />
                        <Button Content="{DynamicResource Monitor.BtnRefreshHistory}"
                                Command="{Binding RefreshHistoryJobsCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="10,4" />
                    </StackPanel>

                    <ScrollViewer x:Name="HistoryJobsScrollHost"
                                  Grid.Row="1"
                                  Background="{DynamicResource BgSurface0Brush}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  CanContentScroll="False"
                                  b:SmoothScrollBehavior.IsEnabled="True"
                                  b:SmoothScrollBehavior.ScrollAmount="60"
                                  b:MouseWheelRoutingBehavior.IsEnabled="True">
                        <Grid Background="{DynamicResource BgSurface0Brush}"
                              MinWidth="940"
                              Width="{Binding ElementName=HistoryJobsScrollHost, Path=ViewportWidth}">
                            <shared:EmptyStateView
                                Icon="🗂"
                                EmptyTitle="{DynamicResource Monitor.HistoryEmptyTitle}"
                                EmptyHint="{DynamicResource Monitor.HistoryEmptyHint}"
                                Margin="0,18,0,0"
                                Visibility="{Binding HistoryJobs.Count, Converter={StaticResource ZeroCountToVis}}" />
                            <DataGrid ItemsSource="{Binding HistoryJobs}"
                                      SelectedItem="{Binding SelectedHistoryJob}"
                                      Style="{StaticResource HistoryJobsGridStyle}"
                                      RowStyle="{StaticResource HistoryJobsRowStyle}"
                                      CellStyle="{StaticResource MonitorGridCellStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      RowHeight="38"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Monitor.ColJobId}" Binding="{Binding JobId}" Width="90" ElementStyle="{StaticResource MonitorCompactTextColumnStyle}" />

                                <DataGridTemplateColumn Header="{DynamicResource Monitor.ColName}" Width="1.35*" MinWidth="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding JobName}"
                                                        Style="{StaticResource TrimmedJobCellTextStyle}">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Style="{StaticResource AppToolTipStyle}"
                                                             Placement="Mouse"
                                                             ToolTipService.ShowDuration="60000">
                                                        <TextBlock Text="{Binding JobName}"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="480" />
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{DynamicResource Monitor.ColState}" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding State}"
                                                        Style="{StaticResource TrimmedJobCellTextStyle}"
                                                        ToolTip="{Binding Reason}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource Monitor.ColExitCode}" Binding="{Binding ExitCode}" Width="90" ElementStyle="{StaticResource MonitorCompactTextColumnStyle}" />
                                <DataGridTextColumn Header="{DynamicResource Monitor.ColStartTime}" Binding="{Binding StartTimeDisplay}" Width="170" ElementStyle="{StaticResource MonitorCompactTextColumnStyle}" />
                                <DataGridTextColumn Header="{DynamicResource Monitor.ColEndTime}" Binding="{Binding EndTimeDisplay}" Width="170" ElementStyle="{StaticResource MonitorCompactTextColumnStyle}" />
                                <DataGridTextColumn Header="{DynamicResource Monitor.ColRunTime}" Binding="{Binding RunTimeDisplay}" Width="110" ElementStyle="{StaticResource MonitorCompactTextColumnStyle}" />

                                <DataGridTemplateColumn Header="{DynamicResource Monitor.ColNodes}" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NodeList}"
                                                        Style="{StaticResource TrimmedJobCellTextStyle}"
                                                        ToolTip="{Binding NodeList}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{DynamicResource Monitor.ColAction}" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                              <Button Content="{DynamicResource Monitor.ActionViewDetail}"
                                                      Padding="8,2"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Style="{StaticResource NeutralButtonStyle}"
                                                      Command="{Binding DataContext.ViewHistoryDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
