<UserControl
    x:Class="SlurmJobManager.App.Views.LogViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="380"
    Background="#1E1E2E">

    <DockPanel Margin="12">

        <!-- File path -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Remote File Path" Foreground="#CDD6F4" Margin="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding RemoteFilePath, UpdateSourceTrigger=PropertyChanged}"
                         Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" Padding="6,4"
                         FontFamily="Consolas" />
                <Button Grid.Column="1" Content="Open"
                        Command="{Binding OpenFileCommand}"
                        Margin="4,0,0,0" Padding="8,4"
                        Background="#585B70" Foreground="White" BorderThickness="0" />
            </Grid>
        </StackPanel>

        <!-- Paging controls -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="▲ Older"
                    Command="{Binding LoadOlderCommand}"
                    Padding="6,4" Margin="0,0,4,0"
                    Background="#585B70" Foreground="White" BorderThickness="0" />
            <Button Grid.Column="1" Content="⟳ Latest"
                    Command="{Binding LoadLatestCommand}"
                    Padding="6,4" Margin="0,0,4,0"
                    Background="#89B4FA" Foreground="#1E1E2E"
                    FontWeight="Bold" BorderThickness="0" />
            <Button Grid.Column="2" Content="▼ Newer"
                    Command="{Binding LoadNewerCommand}"
                    Padding="6,4"
                    Background="#585B70" Foreground="White" BorderThickness="0" />
        </Grid>

        <!-- Line info -->
        <TextBlock DockPanel.Dock="Bottom"
                   Margin="0,4,0,0"
                   Foreground="#6C7086" FontSize="11" FontFamily="Consolas">
            <TextBlock.Text>
                <MultiBinding StringFormat="Lines {0}–{1} / {2}">
                    <Binding Path="StartLine" />
                    <Binding Path="EndLine" />
                    <Binding Path="TotalLines" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <!-- Log text area -->
        <ListBox ItemsSource="{Binding Lines}"
                 Background="#181825"
                 Foreground="#CDD6F4"
                 BorderBrush="#45475A"
                 FontFamily="Consolas"
                 FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="2,1" />
                    <Setter Property="Foreground" Value="#CDD6F4" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

    </DockPanel>
</UserControl>
