<UserControl
    x:Class="SlurmJobManager.App.Views.LogViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:SlurmJobManager.App.Behaviors"
    xmlns:conv="clr-namespace:SlurmJobManager.App.Converters"
    xmlns:shared="clr-namespace:SlurmJobManager.App.Views.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="420"
    Background="{DynamicResource BgBaseBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>

    <DockPanel Margin="8">

        <!-- Remote file path -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="{DynamicResource Log.RemoteFilePath}" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding RemoteFilePath, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" />
        </StackPanel>

        <!-- Chunk size + paging controls -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{DynamicResource Log.LinesPerChunk}" Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" />
                <Slider Minimum="50" Maximum="1000" TickFrequency="50"
                        IsSnapToTickEnabled="True"
                        Value="{Binding ChunkSize}"
                        Width="120" VerticalAlignment="Center" Margin="4,0,4,0" />
                <TextBlock Text="{Binding ChunkSize}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Navigation row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{DynamicResource Btn.LoadOlder}"
                        Command="{Binding LoadOlderCommand}"
                        Style="{StaticResource NeutralButtonStyle}"
                        Padding="6,4" Margin="0,0,4,0" />
                <Button Grid.Column="1" Content="{DynamicResource Btn.LoadLatest}"
                        Command="{Binding LoadLatestCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="6,4" Margin="0,0,4,0" />
                <Button Grid.Column="2" Content="{DynamicResource Btn.LoadNewer}"
                        Command="{Binding LoadNewerCommand}"
                        Style="{StaticResource NeutralButtonStyle}"
                        Padding="6,4" Margin="0,0,4,0" />
                <Button Grid.Column="3" Content="{DynamicResource Btn.ClearCache}"
                        Command="{Binding ClearCacheCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Padding="6,4" />
            </Grid>
        </StackPanel>

        <!-- Follow mode + search -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <CheckBox Content="{DynamicResource Log.FollowMode}"
                          IsChecked="{Binding FollowMode}"
                          Foreground="{DynamicResource AccentGreenBrush}"
                          VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="{DynamicResource Log.Interval}"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" />
                <Slider Minimum="1" Maximum="30"
                        Value="{Binding FollowIntervalSeconds}"
                        Width="80" VerticalAlignment="Center" Margin="4,0,4,0" />
                <TextBlock Text="{Binding FollowIntervalSeconds}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Search bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍 "
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" />
            </Grid>
        </StackPanel>

        <!-- Loading indicator + Cancel -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgPanelBrush}"
                Padding="6,3"
                Margin="0,0,0,2"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Status.Loading}"
                           Foreground="{DynamicResource AccentYellowBrush}"
                           FontSize="11" VerticalAlignment="Center" />
                <Button Content="{DynamicResource Btn.CancelLoad}"
                        Command="{Binding CancelLoadCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Margin="8,0,0,0" Padding="6,2" FontSize="11" />
            </StackPanel>
        </Border>

        <!-- Range + cache info + status -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <TextBlock Text="{Binding RangeText}"
                       Style="{StaticResource MutedTextStyle}"
                       FontFamily="Consolas" />
            <TextBlock Text="{Binding CacheText}"
                       Style="{StaticResource MutedTextStyle}" />
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource StatusTextStyle}" />
        </StackPanel>

        <!-- Log lines: smooth-scrolling ScrollViewer wrapping a pixel-scroll ListBox -->
        <Grid>

            <!-- Branded empty-state: shown when no log lines are loaded -->
            <shared:EmptyStateView
                Icon="📋"
                EmptyTitle="{DynamicResource Log.EmptyTitle}"
                EmptyHint="{DynamicResource Log.EmptyHint}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

            <ScrollViewer x:Name="LogScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}"
                          b:SmoothScrollBehavior.IsEnabled="True"
                          b:SmoothScrollBehavior.ScrollAmount="80">
                <ListBox x:Name="LogList"
                         ItemsSource="{Binding Lines}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="{DynamicResource BgCrustBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         FontFamily="Consolas"
                         FontSize="12"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"    Value="2,1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </ScrollViewer>

        </Grid>

    </DockPanel>
</UserControl>
