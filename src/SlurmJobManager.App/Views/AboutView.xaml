<UserControl
    x:Class="SlurmJobManager.App.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:SlurmJobManager.App.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="900"
    Background="{DynamicResource BgBaseBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                  b:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="24,20,24,20">
            <TextBlock Text="{DynamicResource About.Title}"
                       Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="74"
                            Height="74"
                            CornerRadius="10"
                            Background="{DynamicResource BgPanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Top">
                        <Image Width="52"
                               Height="52"
                               Stretch="Uniform"
                               Source="pack://application:,,,/SlurmJobManager.App;component/Assets/AppIcon/server-palm.ico"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{Binding ProductName, Mode=OneWay}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="24"
                                   FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource About.Subtitle}"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.BasicInfoTitle}"
                               Style="{StaticResource SectionHeaderStyle}" />

                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                        <Run Text="{DynamicResource About.VersionLabel}" />
                        <Run Text="{Binding CurrentVersionDisplay, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                        <Run Text="{DynamicResource About.MaintainerLabel}" />
                        <Run Text="{Binding Maintainer, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                        <Run Text="{DynamicResource About.OrganizationLabel}" />
                        <Run Text="{Binding Organization, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                        <Run Text="{DynamicResource About.CopyrightLabel}" />
                        <Run Text="{Binding CopyrightNotice, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                        <Run Text="{DynamicResource About.LicenseLabel}" />
                        <Run Text="{Binding LicenseDisplay, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                        <Run Text="{DynamicResource About.RepositoryLabel}" />
                        <Run Text="{Binding RepositoryAddress, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.DescriptionTitle}"
                               Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="{DynamicResource About.DescriptionBody}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.FeaturesTitle}"
                               Style="{StaticResource SectionHeaderStyle}" />

                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                        <Run Text="• " />
                        <Run Text="{DynamicResource About.Feature1}" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                        <Run Text="• " />
                        <Run Text="{DynamicResource About.Feature2}" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                        <Run Text="• " />
                        <Run Text="{DynamicResource About.Feature3}" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                        <Run Text="• " />
                        <Run Text="{DynamicResource About.Feature4}" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                        <Run Text="• " />
                        <Run Text="{DynamicResource About.Feature5}" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                        <Run Text="• " />
                        <Run Text="{DynamicResource About.Feature6}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.RelatedActionsTitle}"
                               Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="{DynamicResource About.CopyrightSummaryHint}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Content="{DynamicResource About.OpenCopyrightNoticeButton}"
                                Command="{Binding OpenCopyrightNoticeCommand}"
                                Style="{StaticResource NeutralButtonStyle}"
                                Margin="0,0,8,8"
                                Padding="10,5" />
                        <Button Content="{DynamicResource About.OpenThirdPartyNoticesButton}"
                                Command="{Binding OpenThirdPartyNoticesCommand}"
                                Style="{StaticResource NeutralButtonStyle}"
                                Margin="0,0,8,8"
                                Padding="10,5" />
                        <Button Content="{DynamicResource About.OpenRepositoryButton}"
                                Command="{Binding OpenRepositoryCommand}"
                                Style="{StaticResource NeutralButtonStyle}"
                                Margin="0,0,8,8"
                                Padding="10,5" />
                        <Button Content="{DynamicResource About.OpenLogsButton}"
                                Command="{Binding OpenLogsDirectoryCommand}"
                                Style="{StaticResource NeutralButtonStyle}"
                                Margin="0,0,8,8"
                                Padding="10,5" />
                        <Button Content="{DynamicResource About.CheckUpdatesButton}"
                                Command="{Binding CheckUpdatesCommand}"
                                Style="{StaticResource NeutralButtonStyle}"
                                Margin="0,0,8,8"
                                Padding="10,5" />
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource About.CheckUpdatesHint}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
