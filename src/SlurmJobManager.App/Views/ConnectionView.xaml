<UserControl
    x:Class="SlurmJobManager.App.Views.ConnectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="260" d:DesignWidth="380"
    Background="{DynamicResource BgBaseBrush}">

    <StackPanel Margin="12">

        <TextBlock Text="SSH Connection"
                   Style="{StaticResource SectionHeaderStyle}" />

        <!-- Host + Port -->
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Host"
                           Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Port"
                           Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </Grid>

        <!-- Username -->
        <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,6" />

        <!-- Password -->
        <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" />
        <PasswordBox x:Name="PwdBox" Margin="0,0,0,6" />

        <!-- Private key -->
        <TextBlock Text="Private Key (optional)" Style="{StaticResource FieldLabelStyle}" />
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="…"
                    Command="{Binding BrowseKeyCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Margin="4,0,0,0" Padding="8,4" />
        </Grid>

        <!-- Passphrase -->
        <TextBlock Text="Key Passphrase (optional)" Style="{StaticResource FieldLabelStyle}" />
        <PasswordBox x:Name="PassphraseBox" Margin="0,0,0,8" />

        <!-- Action buttons -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Connect"
                    Command="{Binding ConnectCommand}"
                    Style="{StaticResource SuccessButtonStyle}"
                    Padding="6,4" Margin="0,0,4,0" />
            <Button Grid.Column="1" Content="Disconnect"
                    Command="{Binding DisconnectCommand}"
                    Style="{StaticResource DangerButtonStyle}"
                    Padding="6,4" Margin="0,0,4,0" />
            <Button Grid.Column="2" Content="Test"
                    Command="{Binding TestConnectionCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="6,4" />
        </Grid>

        <!-- Status message -->
        <TextBlock Text="{Binding StatusMessage}"
                   Style="{StaticResource StatusTextStyle}" />

    </StackPanel>
</UserControl>
