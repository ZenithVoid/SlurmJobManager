<Window
    x:Class="SlurmJobManager.App.Views.RemoteDirectoryPickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="选择远程目录"
    Height="480" Width="520"
    MinHeight="300" MinWidth="380"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource BgBaseBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Current path -->
        <TextBlock Grid.Row="0"
                   Text="{Binding CurrentPath}"
                   Foreground="{DynamicResource AccentBlueBrush}"
                   FontFamily="Consolas" FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,6" />

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="⬆ 上级" Command="{Binding GoUpCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="8,4" Margin="0,0,6,0" />
            <Button Content="⟳ 刷新" Command="{Binding RefreshCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="8,4" />
        </StackPanel>

        <!-- Directory list -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="DirListBox"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedEntry}"
                     Background="{DynamicResource BgCrustBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderThickness="0"
                     FontFamily="Consolas" FontSize="12"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="DirListBox_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 " FontSize="12" />
                            <TextBlock Text="{Binding}" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource AccentYellowBrush}"
                   FontSize="11" Margin="0,4,0,4"
                   TextWrapping="Wrap" />

        <!-- Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="选中当前目录或双击进入子目录后点击 [选择]"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="选择"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="12,5" Margin="0,0,6,0"
                    Click="BtnSelect_Click" />
            <Button Grid.Column="2" Content="取消"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="12,5"
                    Click="BtnCancel_Click" />
        </Grid>
    </Grid>
</Window>
