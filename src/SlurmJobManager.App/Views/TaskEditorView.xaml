<UserControl
    x:Class="SlurmJobManager.App.Views.TaskEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="320"
    Background="#1E1E2E">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12" >

            <!-- Root directory -->
            <TextBlock Text="Root Directory" Foreground="#CDD6F4" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding RootDirectory, UpdateSourceTrigger=PropertyChanged}"
                         Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" Padding="6,4" />
                <Button Grid.Column="1" Content="…"
                        Command="{Binding BrowseRootDirectoryCommand}"
                        Margin="4,0,0,0" Padding="8,4"
                        Background="#585B70" Foreground="White" BorderThickness="0" />
            </Grid>

            <!-- Task ID -->
            <TextBlock Text="Task ID" Foreground="#CDD6F4" Margin="0,0,0,4" />
            <TextBox Text="{Binding TaskId, UpdateSourceTrigger=PropertyChanged}"
                     Background="#313244" Foreground="#CDD6F4"
                     BorderBrush="#45475A" Padding="6,4" Margin="0,0,0,12" />

            <!-- Template -->
            <TextBlock Text="Parameter Template" Foreground="#CDD6F4" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding TemplateFileName}"
                         Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" Padding="6,4"
                         IsReadOnly="True" />
                <Button Grid.Column="1" Content="Browse"
                        Command="{Binding LoadTemplateCommand}"
                        Margin="4,0,0,0" Padding="8,4"
                        Background="#585B70" Foreground="White" BorderThickness="0" />
            </Grid>

            <!-- Parameters -->
            <TextBlock Text="Parameters" Foreground="#CDD6F4" Margin="0,0,0,4" />
            <DataGrid ItemsSource="{Binding Parameters}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True"
                      Background="#313244" Foreground="#CDD6F4"
                      RowBackground="#313244" AlternatingRowBackground="#2A2A3E"
                      BorderBrush="#45475A" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#45475A"
                      Height="200"
                      Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Buttons -->
            <Button Content="Save Task"
                    Command="{Binding SaveTaskCommand}"
                    Margin="0,0,0,8" Padding="10,6"
                    Background="#89B4FA" Foreground="#1E1E2E"
                    FontWeight="Bold" BorderThickness="0"
                    HorizontalAlignment="Stretch" />
            <Button Content="Submit sbatch"
                    Command="{Binding SubmitJobCommand}"
                    Padding="10,6"
                    Background="#A6E3A1" Foreground="#1E1E2E"
                    FontWeight="Bold" BorderThickness="0"
                    HorizontalAlignment="Stretch" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
