<UserControl
    x:Class="SlurmJobManager.App.Views.TaskEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800" d:DesignWidth="420"
    Background="{DynamicResource BgBaseBrush}">

    <StackPanel Margin="12">

        <TextBlock Text="{DynamicResource Task.Setup}"
                   Style="{StaticResource SectionHeaderStyle}" />

        <!-- Root directory (remote, auto-filled on SSH connect) -->
        <TextBlock Text="{DynamicResource Task.RootDirectory}" Style="{StaticResource FieldLabelStyle}" />
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding RootDirectory, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="…" Command="{Binding BrowseRootDirectoryCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Margin="4,0,0,0" Padding="8,4"
                    ToolTip="{DynamicResource Task.BrowseRemote}" />
        </Grid>

        <!-- Task ID -->
        <TextBlock Text="{DynamicResource Task.TaskId}" Style="{StaticResource FieldLabelStyle}" />
        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding TaskId, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="{DynamicResource Btn.New}" Command="{Binding NewTaskIdCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Margin="4,0,0,0" Padding="8,4" />
        </Grid>
        <!-- TaskId directory validation status -->
        <TextBlock Text="{Binding TaskIdDirectoryStatus}"
                   Style="{StaticResource MutedTextStyle}"
                   Margin="0,0,0,4"
                   FontSize="11" />

        <!-- Remote work dir (auto-computed from Root + TaskId) -->
        <TextBlock Text="{DynamicResource Task.RemoteWorkDir}" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding RemoteWorkDir, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,6" />

        <!-- App path (remote candidates + pin) -->
        <TextBlock Text="{DynamicResource Task.AppPath}" Style="{StaticResource FieldLabelStyle}" />
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      StaysOpenOnEdit="True"
                      ItemsSource="{Binding FilteredAppList}"
                      Text="{Binding AppPath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="📌" Command="{Binding TogglePinAppCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Margin="4,0,0,0" Padding="6,4"
                    ToolTip="{DynamicResource Task.Pin}" />
            <Button Grid.Column="2" Content="⟳" Command="{Binding RefreshAppCandidatesCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Margin="4,0,0,0" Padding="6,4"
                    ToolTip="{DynamicResource Task.Refresh}" />
        </Grid>

        <!-- Save / Load task -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{DynamicResource Btn.SaveTask}" Command="{Binding SaveTaskCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Margin="0,0,4,0" Padding="8,4" />
            <Button Grid.Column="1" Content="{DynamicResource Btn.LoadTask}" Command="{Binding LoadTaskCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="8,4" />
        </Grid>

        <Separator />
        <TextBlock Text="{DynamicResource Task.ParameterTemplates}"
                   Style="{StaticResource SectionHeaderStyle}" />

        <!-- Template selector (from fixed remote dir) -->
        <TextBlock Text="{DynamicResource Task.SelectTemplate}" Style="{StaticResource FieldLabelStyle}" />
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      StaysOpenOnEdit="True"
                      ItemsSource="{Binding FilteredTemplateList}"
                      Text="{Binding SelectedTemplate, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="📌" Command="{Binding TogglePinTemplateCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Margin="4,0,0,0" Padding="6,4"
                    ToolTip="{DynamicResource Task.Pin}" />
            <Button Grid.Column="2" Content="⟳" Command="{Binding RefreshTemplateCandidatesCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Margin="4,0,0,0" Padding="6,4"
                    ToolTip="{DynamicResource Task.Refresh}" />
        </Grid>

        <!-- Template content editor -->
        <TextBlock Text="{DynamicResource Task.TemplateContent}" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding TemplateContent, UpdateSourceTrigger=PropertyChanged}"
                 Background="{DynamicResource BgCrustBrush}"
                 Padding="6,4" Margin="0,0,0,2"
                 FontFamily="Consolas" FontSize="11"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 Height="100" VerticalScrollBarVisibility="Auto" />
        <TextBlock Text="{Binding LastSavedTime}"
                   Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />

        <!-- Save As filename (B4) -->
        <TextBlock Text="{DynamicResource Task.SaveAsFileName}" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding SaveAsFileName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,6" />

        <Button Content="{DynamicResource Btn.SaveParamFile}" Command="{Binding SaveParamFileCommand}"
                Style="{StaticResource PurpleButtonStyle}"
                Padding="8,4" Margin="0,0,0,8"
                HorizontalAlignment="Stretch" />

        <Separator />
        <TextBlock Text="{DynamicResource Task.ExtraParameters}"
                   Style="{StaticResource SectionHeaderStyle}" />

        <DataGrid ItemsSource="{Binding Parameters}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  Height="120" Margin="0,0,0,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Task.ParamKey}"   Binding="{Binding Key}"   Width="*" />
                <DataGridTextColumn Header="{DynamicResource Task.ParamValue}" Binding="{Binding Value}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="{DynamicResource Btn.AddRow}" Command="{Binding AddParamCommand}"
                Style="{StaticResource NeutralButtonStyle}"
                Padding="8,4" Margin="0,0,0,8"
                HorizontalAlignment="Left" />

        <Separator />
        <TextBlock Text="{DynamicResource Task.Submit}"
                   Style="{StaticResource SectionHeaderStyle}" />

        <Button Content="{DynamicResource Btn.SubmitSbatch}" Command="{Binding SubmitJobCommand}"
                Style="{StaticResource SuccessButtonStyle}"
                Padding="10,8"
                HorizontalAlignment="Stretch" Margin="0,0,0,6" />

        <TextBlock Text="{Binding LastJobIdText}"
                   Foreground="{DynamicResource AccentGreenBrush}"
                   FontSize="12" Margin="0,0,0,4" />
        <TextBlock Text="{Binding StatusMessage}"
                   Style="{StaticResource StatusTextStyle}" />

    </StackPanel>
</UserControl>
