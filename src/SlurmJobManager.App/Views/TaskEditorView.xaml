<UserControl
    x:Class="SlurmJobManager.App.Views.TaskEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800" d:DesignWidth="380"
    Background="{DynamicResource BgBaseBrush}">

    <StackPanel Margin="12">

        <TextBlock Text="Task Setup"
                   Style="{StaticResource SectionHeaderStyle}" />

        <!-- Root directory -->
        <TextBlock Text="Root Directory" Style="{StaticResource FieldLabelStyle}" />
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding RootDirectory, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="…" Command="{Binding BrowseRootDirectoryCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Margin="4,0,0,0" Padding="8,4" />
        </Grid>

        <!-- Task ID -->
        <TextBlock Text="Task ID" Style="{StaticResource FieldLabelStyle}" />
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding TaskId, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="New" Command="{Binding NewTaskIdCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Margin="4,0,0,0" Padding="8,4" />
        </Grid>

        <!-- Remote work dir -->
        <TextBlock Text="Remote Work Directory" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding RemoteWorkDir, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,6" />

        <!-- App path -->
        <TextBlock Text="App Path (on remote)" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding AppPath, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,6" />

        <!-- Save / Load task -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Save Task" Command="{Binding SaveTaskCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Margin="0,0,4,0" Padding="8,4" />
            <Button Grid.Column="1" Content="Load Task" Command="{Binding LoadTaskCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="8,4" />
        </Grid>

        <Separator />
        <TextBlock Text="Parameter Templates"
                   Style="{StaticResource SectionHeaderStyle}" />

        <!-- Template directory -->
        <TextBlock Text="Template Directory" Style="{StaticResource FieldLabelStyle}" />
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding TemplateDirectory, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="…" Command="{Binding BrowseTemplateDirectoryCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Margin="4,0,0,0" Padding="8,4" />
        </Grid>

        <!-- Template file selector -->
        <TextBlock Text="Select Template" Style="{StaticResource FieldLabelStyle}" />
        <ComboBox ItemsSource="{Binding TemplateFiles}"
                  SelectedItem="{Binding SelectedTemplate}"
                  Margin="0,0,0,6" />

        <!-- Template content editor -->
        <TextBlock Text="Template Content" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding TemplateContent, UpdateSourceTrigger=PropertyChanged}"
                 Background="{DynamicResource BgCrustBrush}"
                 Padding="6,4" Margin="0,0,0,2"
                 FontFamily="Consolas" FontSize="11"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 Height="100" VerticalScrollBarVisibility="Auto" />
        <TextBlock Text="{Binding LastSavedTime}"
                   Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6" />

        <Button Content="Save Param File" Command="{Binding SaveParamFileCommand}"
                Style="{StaticResource PurpleButtonStyle}"
                Padding="8,4" Margin="0,0,0,8"
                HorizontalAlignment="Stretch" />

        <Separator />
        <TextBlock Text="Extra Parameters"
                   Style="{StaticResource SectionHeaderStyle}" />

        <DataGrid ItemsSource="{Binding Parameters}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  Height="120" Margin="0,0,0,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Key"   Binding="{Binding Key}"   Width="*" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="+ Add Row" Command="{Binding AddParamCommand}"
                Style="{StaticResource NeutralButtonStyle}"
                Padding="8,4" Margin="0,0,0,8"
                HorizontalAlignment="Left" />

        <Separator />
        <TextBlock Text="Submit"
                   Style="{StaticResource SectionHeaderStyle}" />

        <Button Content="Submit sbatch Job" Command="{Binding SubmitJobCommand}"
                Style="{StaticResource SuccessButtonStyle}"
                Padding="10,8"
                HorizontalAlignment="Stretch" Margin="0,0,0,6" />

        <TextBlock Text="{Binding LastJobIdText}"
                   Foreground="{DynamicResource AccentGreenBrush}"
                   FontSize="12" Margin="0,0,0,4" />
        <TextBlock Text="{Binding StatusMessage}"
                   Style="{StaticResource StatusTextStyle}" />

    </StackPanel>
</UserControl>
