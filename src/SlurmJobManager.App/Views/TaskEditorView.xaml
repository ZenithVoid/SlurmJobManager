<UserControl
    x:Class="SlurmJobManager.App.Views.TaskEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:SlurmJobManager.App.Behaviors"
    xmlns:conv="clr-namespace:SlurmJobManager.App.Converters"
    xmlns:vm="clr-namespace:SlurmJobManager.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="860" d:DesignWidth="700"
    Background="{DynamicResource BgBaseBrush}">
    <UserControl.Resources>
        <conv:StyleKeyToStyleConverter x:Key="StyleKeyToStyle" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                  b:SmoothScrollBehavior.IsEnabled="True"
                  b:SmoothScrollBehavior.ScrollAmount="60"
                  b:MouseWheelRoutingBehavior.IsEnabled="True">
        <StackPanel Margin="12">

            <!-- Task Setup -->
            <TextBlock Text="{DynamicResource Task.Setup}"
                       Style="{StaticResource SectionHeaderStyle}" />

            <TextBlock Text="{DynamicResource Task.RootDirectory}" Style="{StaticResource FieldLabelStyle}" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding RootDirectory, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="..." Command="{Binding BrowseRootDirectoryCommand}"
                        Style="{StaticResource NeutralButtonStyle}"
                        AutomationProperties.Name="Browse remote directory"
                        Margin="4,0,0,0" Padding="8,4"
                        ToolTip="{DynamicResource Task.BrowseRemote}" />
            </Grid>

            <TextBlock Text="{DynamicResource Task.TaskId}" Style="{StaticResource FieldLabelStyle}" />
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding TaskId, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="{DynamicResource Btn.New}" Command="{Binding NewTaskIdCommand}"
                        Style="{StaticResource NeutralButtonStyle}"
                        Margin="4,0,0,0" Padding="8,4" />
            </Grid>
            <TextBlock Text="{Binding TaskIdDirectoryStatus}"
                       Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" FontSize="11" />

            <TextBlock Text="{DynamicResource Task.RemoteWorkDir}" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding RemoteWorkDir, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

            <Separator />

            <!-- Task Unit Selector -->
            <TextBlock Text="{DynamicResource Task.TaskUnits}" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="{DynamicResource Task.TaskUnitSelectorDesc}"
                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,6" />

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding TaskUnits}"
                          SelectedItem="{Binding SelectedTaskUnit, Mode=TwoWay}"
                          DisplayMemberPath="TaskName" />
                <Button Grid.Column="1" Content="{DynamicResource Task.AddUnit}"
                        Command="{Binding AddTaskUnitCommand}"
                        Style="{StaticResource NeutralButtonStyle}"
                        Margin="4,0,0,0" Padding="8,4" FontSize="11" />
                <Button Grid.Column="2" Content="{DynamicResource Task.RemoveUnit}"
                        Command="{Binding RemoveTaskUnitCommand}"
                        CommandParameter="{Binding SelectedTaskUnit}"
                        Style="{StaticResource NeutralButtonStyle}"
                        Margin="4,0,0,0" Padding="8,4" FontSize="11" />
            </Grid>

            <TextBlock Text="{DynamicResource Task.UnitName}" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding ActiveUnit.TaskName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,8" />

            <!-- Command builder entry point -->
            <Button Content="{DynamicResource Btn.ConfigureCommand}"
                    Command="{Binding OpenCommandBuilderCommand}"
                    Style="{StaticResource PurpleButtonStyle}"
                    Padding="10,7" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
            <TextBlock Text="{DynamicResource Task.CommandBuilderHint}"
                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,6" />

            <!-- Commands summary (read-only preview) -->
            <Border Style="{StaticResource CardStyle}" Padding="6" Margin="0,0,0,8">
                <DockPanel>
                     <TextBlock DockPanel.Dock="Top"
                                Text="{DynamicResource Task.CommandsSummary}"
                                Style="{StaticResource SectionHeaderStyle}" />
                     <TextBlock Text="{DynamicResource Task.CommandsSummaryEmpty}"
                                TextWrapping="Wrap"
                                Margin="0,4,0,2">
                         <TextBlock.Style>
                             <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                 <Setter Property="Visibility" Value="Collapsed" />
                                 <Style.Triggers>
                                     <DataTrigger Binding="{Binding ActiveUnit.Commands.Count}" Value="0">
                                         <Setter Property="Visibility" Value="Visible" />
                                     </DataTrigger>
                                 </Style.Triggers>
                             </Style>
                         </TextBlock.Style>
                     </TextBlock>
                     <ItemsControl ItemsSource="{Binding ActiveUnit.Commands}">
                         <ItemsControl.Style>
                             <Style TargetType="ItemsControl">
                                 <Setter Property="Visibility" Value="Visible" />
                                 <Style.Triggers>
                                     <DataTrigger Binding="{Binding ActiveUnit.Commands.Count}" Value="0">
                                         <Setter Property="Visibility" Value="Collapsed" />
                                     </DataTrigger>
                                 </Style.Triggers>
                             </Style>
                         </ItemsControl.Style>
                         <ItemsControl.ItemTemplate>
                             <DataTemplate DataType="{x:Type vm:CommandEntryViewModel}">
                                 <TextBlock Text="{Binding CommandLine}"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource AccentYellowBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                 </DockPanel>
             </Border>

            <TextBlock Text="{DynamicResource Task.SaveLoadScopeHint}"
                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{DynamicResource Btn.SaveTask}" Command="{Binding SaveTaskCommand}"
                        Style="{StaticResource AccentButtonStyle}" Margin="0,0,4,0" Padding="8,4" />
                <Button Grid.Column="1" Content="{DynamicResource Btn.LoadTask}" Command="{Binding LoadTaskCommand}"
                        Style="{StaticResource NeutralButtonStyle}" Padding="8,4" />
            </Grid>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{DynamicResource Btn.SaveAsBlueprint}" Command="{Binding SaveAsBlueprintCommand}"
                        Style="{StaticResource NeutralButtonStyle}" Margin="0,0,4,0" Padding="8,4" />
                <Button Grid.Column="1" Content="{DynamicResource Btn.CreateFromBlueprint}" Command="{Binding CreateFromBlueprintCommand}"
                        Style="{StaticResource NeutralButtonStyle}" Padding="8,4" />
            </Grid>
            <TextBlock Text="{Binding LastSavedTime}"
                       Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8" FontSize="11" />

            <Separator />

            <!-- Submit -->
            <TextBlock Text="{DynamicResource Task.Submit}" Style="{StaticResource SectionHeaderStyle}" />

            <Button Content="{DynamicResource Btn.SubmitSbatch}" Command="{Binding SubmitJobCommand}"
                    Style="{StaticResource SuccessButtonStyle}"
                    Padding="10,8" HorizontalAlignment="Stretch" Margin="0,0,0,6" />

             <TextBlock Text="{Binding LastJobIdText}"
                       Style="{StaticResource SuccessTextStyle}"
                       FontSize="12" Margin="0,0,0,4" />
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{Binding StatusStyleKey, Converter={StaticResource StyleKeyToStyle}}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
