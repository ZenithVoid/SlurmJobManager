<Window
    x:Class="SlurmJobManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:SlurmJobManager.App.Views"
    mc:Ignorable="d"
    Title="Slurm Job Manager"
    Height="800" Width="1280"
    MinHeight="600" MinWidth="960"
    Background="{DynamicResource BgBaseBrush}">

    <Window.Resources>
        <!-- Fade-in storyboard for content panels -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                Duration="0:0:0.18" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Slurm Job Manager"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Connection.StatusText}"
                           Foreground="{DynamicResource AccentGreenBrush}"
                           FontSize="13" VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <!-- Theme toggle -->
                <Button Grid.Column="2"
                        Content="{Binding ThemeToggleLabel}"
                        Command="{Binding ToggleThemeCommand}"
                        Style="{StaticResource NeutralButtonStyle}"
                        Padding="8,4" />
            </Grid>
        </Border>

        <!-- Three-panel content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*"   MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="420" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Left panel: Connection + Task Editor -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    x:Name="LeftPanel">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                    </EventTrigger>
                </Border.Triggers>
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource BgPanelBrush}"
                            Padding="8,6">
                        <TextBlock Text="Connection &amp; Task Editor"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="Bold" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource BgBaseBrush}">
                        <StackPanel>
                            <views:ConnectionView DataContext="{Binding Connection}" />
                            <Separator />
                            <views:TaskEditorView DataContext="{Binding TaskEditor}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" />

            <!-- Centre panel: Monitor -->
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    x:Name="CentrePanel">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                    </EventTrigger>
                </Border.Triggers>
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource BgPanelBrush}"
                            Padding="8,6">
                        <TextBlock Text="Job Monitor"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="Bold" />
                    </Border>
                    <views:MonitorView DataContext="{Binding Monitor}" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" />

            <!-- Right panel: Log Viewer + Console tabs -->
            <DockPanel Grid.Column="4" x:Name="RightPanel">
                <DockPanel.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                    </EventTrigger>
                </DockPanel.Triggers>
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource BgPanelBrush}"
                        Padding="8,6">
                    <TextBlock Text="Logs &amp; Console"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontWeight="Bold" />
                </Border>
                <TabControl>
                    <TabItem Header="Log Viewer">
                        <views:LogViewerView DataContext="{Binding LogViewer}" />
                    </TabItem>
                    <TabItem Header="Console">
                        <views:ConsoleView DataContext="{Binding Console}" />
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgCrustBrush}"
                Padding="8,4">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12" />
        </Border>
    </Grid>
</Window>
