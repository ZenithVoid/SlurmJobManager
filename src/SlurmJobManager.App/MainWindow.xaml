<Window
    x:Class="SlurmJobManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SlurmJobManager.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:SlurmJobManager.App.Views"
    mc:Ignorable="d"
    Title="Slurm Job Manager"
    Height="800" Width="1280"
    MinHeight="600" MinWidth="900"
    Background="{DynamicResource BgBaseBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <!-- Fade-in storyboard for content panels -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                Duration="0:0:0.18" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="200" MinWidth="160" />
            <!-- Resize handle -->
            <ColumnDefinition Width="1" />
            <!-- Main content -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ─────────────────────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- App branding block -->
                <Border DockPanel.Dock="Top"
                        Padding="16,18,16,12"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Slurm Job"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="16" FontWeight="Bold"
                                   LineHeight="20" />
                        <TextBlock Text="Manager"
                                   Foreground="{DynamicResource AccentBlueBrush}"
                                   FontSize="16" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Connection status pill -->
                <Border DockPanel.Dock="Top"
                        Margin="10,10,10,2"
                        Padding="10,5"
                        Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock Text="{Binding Connection.StatusText}"
                               Foreground="{DynamicResource AccentGreenBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Status bar at bottom -->
                <Border DockPanel.Dock="Bottom"
                        Padding="12,8"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Navigation list -->
                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedValue="{Binding ActiveTab, Mode=TwoWay}"
                         SelectedValuePath="TabId"
                         Style="{StaticResource SidebarListBoxStyle}"
                         Margin="0,4,0,0" />

            </DockPanel>
        </Border>

        <!-- Sidebar / content separator -->
        <Border Grid.Column="1"
                Background="{DynamicResource BorderBrush}" />

        <!-- ── Main content area ──────────────────────────────────────── -->
        <Grid Grid.Column="2">

            <!-- Dashboard -->
            <views:DashboardView
                DataContext="{Binding Dashboard}"
                Visibility="{Binding ShowDashboard, Converter={StaticResource BoolToVis}}">
                <views:DashboardView.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                    </EventTrigger>
                </views:DashboardView.Triggers>
            </views:DashboardView>

            <!-- Tasks -->
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding ShowTasks, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource BgBaseBrush}">
                <views:TaskEditorView DataContext="{Binding TaskEditor}"
                                      Margin="24,20,24,20" />
            </ScrollViewer>

            <!-- Monitor -->
            <views:MonitorView
                DataContext="{Binding Monitor}"
                Visibility="{Binding ShowMonitor, Converter={StaticResource BoolToVis}}"
                Margin="24,20,24,20">
                <views:MonitorView.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                    </EventTrigger>
                </views:MonitorView.Triggers>
            </views:MonitorView>

            <!-- Logs -->
            <views:LogViewerView
                DataContext="{Binding LogViewer}"
                Visibility="{Binding ShowLogs, Converter={StaticResource BoolToVis}}"
                Margin="24,20,24,20">
                <views:LogViewerView.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                    </EventTrigger>
                </views:LogViewerView.Triggers>
            </views:LogViewerView>

            <!-- Console -->
            <views:ConsoleView
                DataContext="{Binding Console}"
                Visibility="{Binding ShowConsole, Converter={StaticResource BoolToVis}}"
                Margin="24,20,24,20">
                <views:ConsoleView.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                    </EventTrigger>
                </views:ConsoleView.Triggers>
            </views:ConsoleView>

            <!-- Settings -->
            <views:SettingsView
                DataContext="{Binding Settings}"
                Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVis}}">
                <views:SettingsView.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                    </EventTrigger>
                </views:SettingsView.Triggers>
            </views:SettingsView>

        </Grid>
    </Grid>
</Window>
