<Window
    x:Class="SlurmJobManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SlurmJobManager.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:SlurmJobManager.App.Views"
    xmlns:shared="clr-namespace:SlurmJobManager.App.Views.Shared"
    mc:Ignorable="d"
    Title="Slurm Job Manager"
    Height="800" Width="1280"
    MinHeight="600" MinWidth="900"
    WindowStyle="None"
    AllowsTransparency="False"
    ResizeMode="CanResize"
    Background="{DynamicResource BgBaseBrush}">

    <!-- WindowChrome: enables resize, snap, and custom caption without AllowsTransparency -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="36"
            ResizeBorderThickness="5"
            GlassFrameThickness="0,0,0,1"
            CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />

        <!-- Title-bar window control button style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width"               Value="46" />
            <Setter Property="Height"              Value="36" />
            <Setter Property="BorderThickness"     Value="0" />
            <Setter Property="Background"          Value="Transparent" />
            <Setter Property="Foreground"          Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize"            Value="12" />
            <Setter Property="FocusVisualStyle"    Value="{x:Null}" />
            <Setter Property="VerticalAlignment"   Value="Stretch" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Width="{TemplateBinding Width}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.80" Duration="0:0:0.12"
                                                         FillBehavior="HoldEnd" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1.0" Duration="0:0:0.12"
                                                         FillBehavior="HoldEnd" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BgSurface0Brush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource BgSurface1Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button has a red hover background -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#C42B1C" />
                    <Setter Property="Foreground"  Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background"  Value="#9E2115" />
                    <Setter Property="Foreground"  Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom title bar -->
            <RowDefinition Height="36" />
            <!-- Body (sidebar + content) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Custom title bar ──────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <!-- Draggable region -->
                <Border x:Name="TitleBarDragArea"
                        Background="Transparent"
                        HorizontalAlignment="Stretch"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        MouseMove="TitleBar_MouseMove" />

                <!-- App name (centred) -->
                <TextBlock Text="{DynamicResource App.Title}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="SemiBold"
                           IsHitTestVisible="False" />

                <!-- Window control buttons (right-aligned) -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button x:Name="BtnMinimize"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="{DynamicResource TitleBar.Minimize}"
                            Click="BtnMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="BtnMaximize"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="{DynamicResource TitleBar.Maximize}"
                            Click="BtnMaximize_Click">
                        <TextBlock x:Name="MaximizeIcon"
                                   Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="BtnClose"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            ToolTip="{DynamicResource TitleBar.Close}"
                            Click="BtnClose_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="160" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ────────────────────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- App branding block -->
                    <Border DockPanel.Dock="Top"
                            Padding="16,18,16,12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource App.TitleLine1}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="16" FontWeight="Bold"
                                       LineHeight="20" />
                            <TextBlock Text="{DynamicResource App.TitleLine2}"
                                       Foreground="{DynamicResource AccentBlueBrush}"
                                       FontSize="16" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- Connection status pill -->
                    <Border DockPanel.Dock="Top"
                            Margin="10,10,10,2"
                            Padding="10,5"
                            Background="{DynamicResource BgCardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Text="{Binding Connection.StatusText}"
                                   Foreground="{DynamicResource AccentGreenBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- Status bar at bottom -->
                    <Border DockPanel.Dock="Bottom"
                            Padding="12,8"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- Navigation list -->
                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding ActiveNavItem, Mode=TwoWay}"
                             Style="{StaticResource SidebarListBoxStyle}"
                             Margin="0,4,0,0" />
                </DockPanel>
            </Border>

            <!-- Sidebar / content separator -->
            <Border Grid.Column="1"
                    Background="{DynamicResource BorderBrush}" />

            <!-- ── Main content area ──────────────────────────────────────── -->
            <Grid Grid.Column="2">

                <!-- Dashboard – wrap in Grid for RenderTransform -->
                <Grid x:Name="PageDashboard"
                      Visibility="{Binding ShowDashboard, Converter={StaticResource BoolToVis}}"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScaleDashboard" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <views:DashboardView DataContext="{Binding Dashboard}" />
                </Grid>

                <!-- Tasks -->
                <Grid x:Name="PageTasks"
                      Visibility="{Binding ShowTasks, Converter={StaticResource BoolToVis}}"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScaleTasks" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="340" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: task editor form -->
                    <ScrollViewer Grid.Column="0"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource BgBaseBrush}">
                        <views:TaskEditorView DataContext="{Binding TaskEditor}"
                                              Margin="24,20,24,20" />
                    </ScrollViewer>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1"
                                  Width="4"
                                  HorizontalAlignment="Stretch"
                                  Background="{DynamicResource BorderBrush}"
                                  ResizeBehavior="PreviousAndNext" />

                    <!-- Right: task directory file list (B5) -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource BgPanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,0">
                        <DockPanel Margin="12">
                            <!-- Header + refresh -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="{DynamicResource Task.TaskFiles}"
                                           Style="{StaticResource SectionHeaderStyle}"
                                           DockPanel.Dock="Left"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,0" />
                                <Button Content="⟳"
                                        Command="{Binding TaskEditor.RefreshTaskFilesCommand}"
                                        Style="{StaticResource NeutralButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Padding="6,3"
                                        ToolTip="{DynamicResource Task.Refresh}" />
                            </DockPanel>

                            <!-- Path hint -->
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding TaskEditor.RemoteWorkDir}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontFamily="Consolas" FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,6" />

                            <!-- File list -->
                            <ListBox x:Name="TaskFileListBox"
                                     ItemsSource="{Binding TaskEditor.TaskFiles}"
                                     SelectedItem="{Binding TaskEditor.SelectedTaskFile}"
                                     Background="{DynamicResource BgCrustBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     FontFamily="Consolas" FontSize="12"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     MouseDoubleClick="TaskFileListBox_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄 " FontSize="12" />
                                            <TextBlock Text="{Binding}" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Monitor -->
                <Grid x:Name="PageMonitor"
                      Visibility="{Binding ShowMonitor, Converter={StaticResource BoolToVis}}"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScaleMonitor" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <views:MonitorView DataContext="{Binding Monitor}"
                                       Margin="24,20,24,20" />
                </Grid>

                <!-- Logs -->
                <Grid x:Name="PageLogs"
                      Visibility="{Binding ShowLogs, Converter={StaticResource BoolToVis}}"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScaleLogs" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <views:LogViewerView DataContext="{Binding LogViewer}"
                                         Margin="24,20,24,20" />
                </Grid>

                <!-- Console -->
                <Grid x:Name="PageConsole"
                      Visibility="{Binding ShowConsole, Converter={StaticResource BoolToVis}}"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScaleConsole" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <views:ConsoleView DataContext="{Binding Console}"
                                       Margin="24,20,24,20" />
                </Grid>

                <!-- Settings -->
                <Grid x:Name="PageSettings"
                      Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVis}}"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScaleSettings" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <views:SettingsView DataContext="{Binding Settings}" />
                </Grid>

            </Grid>
        </Grid>

        <!-- ── Toast notification overlay (top-right, above all content) ── -->
        <shared:ToastContainerView
            x:Name="ToastContainer"
            Grid.Row="0" Grid.RowSpan="2"
            Panel.ZIndex="9999"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,44,16,0"
            IsHitTestVisible="True" />

    </Grid>
</Window>
