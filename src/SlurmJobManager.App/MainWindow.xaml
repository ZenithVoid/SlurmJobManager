<Window
    x:Class="SlurmJobManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SlurmJobManager.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:b="clr-namespace:SlurmJobManager.App.Behaviors"
    xmlns:views="clr-namespace:SlurmJobManager.App.Views"
    xmlns:shared="clr-namespace:SlurmJobManager.App.Views.Shared"
    mc:Ignorable="d"
    Title="Slurm Job Manager"
    Height="800" Width="1280"
    MinHeight="600" MinWidth="900"
    WindowStyle="None"
    AllowsTransparency="False"
    ResizeMode="CanResize"
    Background="{DynamicResource BgBaseBrush}">

    <!-- WindowChrome: enables resize, snap, and custom caption without AllowsTransparency -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="36"
            ResizeBorderThickness="5"
            GlassFrameThickness="0,0,0,1"
            CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountToVis" />
        <conv:ConnectionStatusToBrushConverter x:Key="ConnStatusToBrush" />
        <conv:StyleKeyToStyleConverter x:Key="StyleKeyToStyle" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom title bar -->
            <RowDefinition Height="36" />
            <!-- Body (sidebar + content) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Custom title bar ──────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <!-- Draggable region -->
                <Border x:Name="TitleBarDragArea"
                        Background="Transparent"
                        HorizontalAlignment="Stretch"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        MouseMove="TitleBar_MouseMove" />

                <!-- App name (centred) -->
                <TextBlock Text="{DynamicResource App.Title}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="SemiBold"
                           IsHitTestVisible="False" />

                <!-- Window control buttons (right-aligned) -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button x:Name="BtnMinimize"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="{DynamicResource TitleBar.Minimize}"
                            Click="BtnMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="BtnMaximize"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="{DynamicResource TitleBar.Maximize}"
                            Click="BtnMaximize_Click">
                        <TextBlock x:Name="MaximizeIcon"
                                   Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="BtnClose"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            ToolTip="{DynamicResource TitleBar.Close}"
                            Click="BtnClose_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="160" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ────────────────────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- App branding block -->
                    <Border DockPanel.Dock="Top"
                            Padding="16,18,16,12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource App.TitleLine1}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="16" FontWeight="Bold"
                                       LineHeight="20" />
                            <TextBlock Text="{DynamicResource App.TitleLine2}"
                                       Foreground="{DynamicResource AccentBlueBrush}"
                                       FontSize="16" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- Connection status pill -->
                    <Border DockPanel.Dock="Top"
                            Margin="10,10,10,2"
                            Padding="10,5"
                            Background="{DynamicResource BgCardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Text="{Binding Connection.StatusText}"
                                   Foreground="{Binding Connection.Status, Converter={StaticResource ConnStatusToBrush}}"
                                    FontSize="11"
                                    TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- Status bar at bottom -->
                    <Border DockPanel.Dock="Bottom"
                            Padding="12,8"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- Navigation list -->
                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding ActiveNavItem, Mode=TwoWay}"
                             Style="{StaticResource SidebarListBoxStyle}"
                             Margin="0,4,0,0" />
                </DockPanel>
            </Border>

            <!-- Sidebar / content separator -->
            <Border Grid.Column="1"
                    Background="{DynamicResource BorderBrush}" />

            <!-- ── Main content area ──────────────────────────────────────── -->
            <Grid Grid.Column="2">

                <!-- Dashboard – wrap in Grid for RenderTransform -->
                <Grid x:Name="PageDashboard"
                      Visibility="{Binding ShowDashboard, Converter={StaticResource BoolToVis}}"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScaleDashboard" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <views:DashboardView DataContext="{Binding Dashboard}" />
                </Grid>

                <!-- Tasks -->
                <Grid x:Name="PageTasks"
                      Visibility="{Binding ShowTasks, Converter={StaticResource BoolToVis}}"
                      Focusable="True"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScaleTasks" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="340" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: task editor form (TaskEditorView owns its own ScrollViewer + behaviors) -->
                    <views:TaskEditorView x:Name="TaskPageView"
                                          Grid.Column="0"
                                          DataContext="{Binding TaskEditor}"
                                          Margin="24,20,24,20" />

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1"
                                  Width="4"
                                  HorizontalAlignment="Stretch"
                                  Background="{DynamicResource BorderBrush}"
                                  ResizeBehavior="PreviousAndNext" />

                    <!-- Right: task directory file list (B5) -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource BgPanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,0">
                        <DockPanel Margin="12">
                            <Border DockPanel.Dock="Top" Style="{StaticResource PageHeaderCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Task.SideTitle}" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                                     <Button Grid.Column="1"
                                             Content="ⓘ"
                                             Style="{StaticResource GhostButtonStyle}"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Margin="8,0,0,0"
                                             VerticalAlignment="Center">
                                         <Button.ToolTip>
                                            <ToolTip MaxWidth="560"
                                                     Placement="Bottom"
                                                     Style="{StaticResource AppToolTipStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource Task.ContextInfoButtonHint}"
                                                                Style="{StaticResource MutedTextStyle}"
                                                                Margin="0,0,0,6" />
                                                    <TextBlock Text="{DynamicResource Task.ContextInfoTitle}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               Margin="0,0,0,6" />
                                                    <StackPanel>
                                                        <TextBlock Text="{DynamicResource Task.ContextInfoTaskIdLabel}"
                                                                   Style="{StaticResource MutedTextStyle}" />
                                                        <TextBlock Text="{Binding TaskEditor.TaskContextTaskIdDisplay}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,1,0,0" />

                                                        <TextBlock Text="{DynamicResource Task.ContextInfoWorkDirLabel}"
                                                                   Style="{StaticResource MutedTextStyle}"
                                                                   Margin="0,6,0,0" />
                                                        <TextBlock Text="{Binding TaskEditor.TaskContextWorkDirDisplay}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,1,0,0" />
                                                        <TextBlock Text="{Binding TaskEditor.RemoteWorkDir}"
                                                                   Style="{StaticResource MutedTextStyle}"
                                                                   TextWrapping="Wrap"
                                                                   AutomationProperties.Name="{Binding TaskEditor.RemoteWorkDir, StringFormat=完整工作目录路径：{0}}"
                                                                   Margin="0,1,0,0" />

                                                        <TextBlock Text="{DynamicResource Task.ContextInfoFilePathLabel}"
                                                                   Style="{StaticResource MutedTextStyle}"
                                                                   Margin="0,6,0,0" />
                                                        <TextBlock Text="{Binding TaskEditor.TaskContextFilePathDisplay}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,1,0,0" />
                                                        <TextBlock Text="{Binding TaskEditor.CurrentTaskFilesPath}"
                                                                   Style="{StaticResource MutedTextStyle}"
                                                                   TextWrapping="Wrap"
                                                                   AutomationProperties.Name="{Binding TaskEditor.CurrentTaskFilesPath, StringFormat=完整当前文件路径：{0}}"
                                                                   Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock DockPanel.Dock="Top"
                                        Text="{DynamicResource Task.CurrentPath}"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="0,0,0,3" />
                            <TextBox DockPanel.Dock="Top"
                                      Text="{Binding TaskEditor.CurrentTaskFilesPathDisplay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{Binding TaskEditor.CurrentTaskFilesPath}"
                                      FontFamily="Consolas"
                                      FontSize="11"
                                      Margin="0,0,0,6">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding TaskEditor.RefreshTaskFilesCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="⬆"
                                        Command="{Binding TaskEditor.GoUpTaskFilesPathCommand}"
                                        Style="{StaticResource NeutralButtonStyle}"
                                        Padding="6,3"
                                        Margin="0,0,4,0"
                                        ToolTip="{DynamicResource Task.PathUp}" />
                                <Button Grid.Column="1" Content="{DynamicResource Btn.Refresh}"
                                        Command="{Binding TaskEditor.RefreshTaskFilesCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="8,4"
                                        Margin="0,0,4,0" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource Btn.OpenInTerminal}"
                                        Command="{Binding TaskEditor.OpenInConsoleCommand}"
                                        Style="{StaticResource NeutralButtonStyle}"
                                        ToolTip="{DynamicResource Task.OpenInTerminalHint}"
                                        Padding="8,4" />
                            </Grid>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{DynamicResource Task.FileMenuNewFile}"
                                        Command="{Binding TaskEditor.CreateTaskFileCommand}"
                                        Style="{StaticResource NeutralButtonStyle}"
                                        Padding="8,4"
                                        Margin="0,0,4,0" />
                                <Button Grid.Column="1" Content="{DynamicResource Task.FileMenuNewDirectory}"
                                        Command="{Binding TaskEditor.CreateTaskDirectoryCommand}"
                                        Style="{StaticResource NeutralButtonStyle}"
                                        Padding="8,4"
                                        Margin="0,0,4,0" />
                                <Button Grid.Column="2" Content="{DynamicResource Task.FileMenuUpload}"
                                        Command="{Binding TaskEditor.UploadTaskFileCommand}"
                                        Style="{StaticResource NeutralButtonStyle}"
                                        Padding="8,4" />
                            </Grid>

                            <Border DockPanel.Dock="Top" Style="{StaticResource StatusPanelStyle}">
                                <TextBlock Text="{Binding TaskEditor.EffectiveStatusMessage}"
                                           Style="{Binding TaskEditor.EffectiveStatusStyleKey, Converter={StaticResource StyleKeyToStyle}}" />
                            </Border>

                            <!-- File list: outer ScrollViewer owns smooth + routing so hover-scroll works without focus -->
                            <ScrollViewer b:SmoothScrollBehavior.IsEnabled="True"
                                          b:SmoothScrollBehavior.ScrollAmount="60"
                                          b:MouseWheelRoutingBehavior.IsEnabled="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <shared:EmptyStateView
                                        Icon="🗃"
                                        EmptyTitle="{DynamicResource Task.TaskFilesEmptyTitle}"
                                        EmptyHint="{DynamicResource Task.TaskFilesHint}"
                                        Margin="0,24,0,0"
                                        Visibility="{Binding TaskEditor.TaskFiles.Count,
                                                             Converter={StaticResource ZeroCountToVis}}" />
                                     <ListBox x:Name="TaskFileListBox"
                                                ItemsSource="{Binding TaskEditor.TaskFiles}"
                                                SelectedItem="{Binding TaskEditor.SelectedTaskFile}"
                                                SelectionMode="Extended"
                                                MouseDoubleClick="TaskFileListBox_MouseDoubleClick"
                                                PreviewMouseRightButtonDown="TaskFileListBox_PreviewMouseRightButtonDown"
                                                Background="{DynamicResource BgCrustBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                HorizontalContentAlignment="Stretch"
                                                FontFamily="Consolas" FontSize="12"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                         <ListBox.ContextMenu>
                                              <ContextMenu Opened="TaskFileContextMenu_Opened">
                                                  <MenuItem x:Name="TaskFileContextNewFileMenuItem"
                                                            Header="{DynamicResource Task.FileMenuNewFile}"
                                                            Command="{Binding PlacementTarget.DataContext.TaskEditor.CreateTaskFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                  <MenuItem x:Name="TaskFileContextNewDirectoryMenuItem"
                                                            Header="{DynamicResource Task.FileMenuNewDirectory}"
                                                            Command="{Binding PlacementTarget.DataContext.TaskEditor.CreateTaskDirectoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                  <MenuItem x:Name="TaskFileContextUploadMenuItem"
                                                            Header="{DynamicResource Task.FileMenuUpload}"
                                                            Command="{Binding PlacementTarget.DataContext.TaskEditor.UploadTaskFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                  <Separator />
                                                  <MenuItem x:Name="TaskFileContextOpenMenuItem"
                                                            Header="{DynamicResource Task.FileMenuOpen}"
                                                            Command="{Binding PlacementTarget.DataContext.TaskEditor.OpenTaskFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                  <MenuItem x:Name="TaskFileContextRenameMenuItem"
                                                            Header="{DynamicResource Task.FileMenuRename}"
                                                            Command="{Binding PlacementTarget.DataContext.TaskEditor.RenameTaskFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                  <MenuItem x:Name="TaskFileContextDownloadMenuItem"
                                                            Header="{DynamicResource Task.FileMenuDownload}"
                                                            Command="{Binding PlacementTarget.DataContext.TaskEditor.DownloadTaskFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                  <MenuItem x:Name="TaskFileContextDeleteMenuItem"
                                                            Header="{DynamicResource Task.FileMenuDelete}"
                                                            Click="TaskFileContextDelete_Click" />
                                                <MenuItem x:Name="TaskFileContextTimeInfoMenuItem"
                                                          Header="{DynamicResource Task.FileMenuViewTimeInfo}"
                                                          Click="TaskFileContextViewTimeInfo_Click" />
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.Style>
                                            <Style TargetType="ListBox">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TaskEditor.TaskFiles.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.Style>
                                         <ListBox.ItemContainerStyle>
                                             <Style TargetType="ListBoxItem">
                                                 <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                 <EventSetter Event="PreviewMouseLeftButtonDown"
                                                              Handler="TaskFileListItem_PreviewMouseLeftButtonDown" />
                                                 <EventSetter Event="PreviewMouseRightButtonDown"
                                                              Handler="TaskFileListItem_PreviewMouseRightButtonDown" />
                                             </Style>
                                         </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding RemotePath}" Background="Transparent" Margin="2,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="📄 " FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="📄 " />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                        <Setter Property="Text" Value="📁 " />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayName}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Monitor -->
                <Grid x:Name="PageMonitor"
                      Visibility="{Binding ShowMonitor, Converter={StaticResource BoolToVis}}"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScaleMonitor" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <views:MonitorView DataContext="{Binding Monitor}"
                                       Margin="24,20,24,20" />
                </Grid>

                <!-- Logs -->
                <Grid x:Name="PageLogs"
                      Visibility="{Binding ShowLogs, Converter={StaticResource BoolToVis}}"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScaleLogs" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <views:LogViewerView DataContext="{Binding LogViewer}"
                                         Margin="24,20,24,20" />
                </Grid>

                <!-- Console -->
                <Grid x:Name="PageConsole"
                      Visibility="{Binding ShowConsole, Converter={StaticResource BoolToVis}}"
                      Focusable="True"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScaleConsole" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <views:ConsoleView x:Name="ConsolePageView"
                                       DataContext="{Binding Console}"
                                       Margin="24,20,24,20" />
                </Grid>

                <!-- Settings -->
                <Grid x:Name="PageSettings"
                      Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVis}}"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScaleSettings" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <views:SettingsView DataContext="{Binding Settings}" />
                </Grid>

            </Grid>
        </Grid>

        <!-- ── Toast notification overlay (top-right, above all content) ── -->
        <shared:ToastContainerView
            x:Name="ToastContainer"
            Grid.Row="0" Grid.RowSpan="2"
            Panel.ZIndex="9999"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,44,16,0"
            IsHitTestVisible="True" />

    </Grid>
</Window>
