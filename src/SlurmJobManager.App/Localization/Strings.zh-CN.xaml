    <sys:String x:Key="Btn.SaveTask">保存任务</sys:String>
    <sys:String x:Key="Btn.LoadTask">加载任务</sys:String>
    <sys:String x:Key="Btn.SaveParamFile">保存参数文件</sys:String>
    <sys:String x:Key="Btn.AddRow">+ 添加行</sys:String>
    <sys:String x:Key="Btn.SubmitSbatch">提交 sbatch 作业</sys:String>
    <sys:String x:Key="Btn.Run">运行</sys:String>
    <sys:String x:Key="Btn.CancelCmd">✕ 取消</sys:String>
    <sys:String x:Key="Btn.Copy">复制</sys:String>
    <sys:String x:Key="Btn.Clear">清除</sys:String>

    <!-- ── 状态文本 ──────────────────────────────────────────────────────── -->
    <sys:String x:Key="Status.Ready">就绪</sys:String>
    <sys:String x:Key="Status.Connected">已连接</sys:String>
    <sys:String x:Key="Status.Disconnected">未连接</sys:String>
    <sys:String x:Key="Status.Connecting">连接中…</sys:String>
    <sys:String x:Key="Status.Loading">⏳ 加载中…</sys:String>
    <sys:String x:Key="Status.Error">错误</sys:String>

    <!-- ── 仪表盘 ──────────────────────────────────────────────────────── -->
    <sys:String x:Key="Dashboard.Title">仪表盘</sys:String>
    <sys:String x:Key="Dashboard.Connection">连接</sys:String>
    <sys:String x:Key="Dashboard.QuickActions">快捷操作</sys:String>
    <sys:String x:Key="Dashboard.JobSummary">作业摘要</sys:String>
    <sys:String x:Key="Dashboard.Total">总计</sys:String>
    <sys:String x:Key="Dashboard.Running">运行中</sys:String>
    <sys:String x:Key="Dashboard.Pending">等待中</sys:String>
