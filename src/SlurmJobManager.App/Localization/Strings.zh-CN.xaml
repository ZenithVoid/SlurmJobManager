    <sys:String x:Key="Monitor.Title">作业监控</sys:String>
    <sys:String x:Key="Monitor.WatchUser">监控用户</sys:String>
    <sys:String x:Key="Monitor.PollInterval">轮询间隔 (秒)：</sys:String>
    <sys:String x:Key="Monitor.Filter">筛选：</sys:String>
    <sys:String x:Key="Monitor.ColJobId">作业 ID</sys:String>
    <sys:String x:Key="Monitor.ColName">名称</sys:String>
    <sys:String x:Key="Monitor.ColUser">用户</sys:String>
    <sys:String x:Key="Monitor.ColState">状态</sys:String>
    <sys:String x:Key="Monitor.ColPartition">分区</sys:String>
    <sys:String x:Key="Monitor.ColRunTime">运行时长</sys:String>
    <sys:String x:Key="Monitor.ColNodes">节点</sys:String>

