    <sys:String x:Key="Task.Setup">任务配置</sys:String>
    <sys:String x:Key="Task.RootDirectory">根目录</sys:String>
    <sys:String x:Key="Task.TaskId">任务 ID</sys:String>
    <sys:String x:Key="Task.RemoteWorkDir">远程工作目录</sys:String>
    <sys:String x:Key="Task.AppPath">应用路径（远程）</sys:String>
    <sys:String x:Key="Task.ParameterTemplates">参数模板</sys:String>
    <sys:String x:Key="Task.TemplateDirectory">模板目录</sys:String>
    <sys:String x:Key="Task.SelectTemplate">选择模板</sys:String>
    <sys:String x:Key="Task.TemplateContent">模板内容</sys:String>
    <sys:String x:Key="Task.ExtraParameters">额外参数</sys:String>
    <sys:String x:Key="Task.ParamKey">键</sys:String>
    <sys:String x:Key="Task.ParamValue">值</sys:String>
    <sys:String x:Key="Task.Submit">提交</sys:String>

    <!-- ── 终端视图 ──────────────────────────────────────────────────────── -->

</ResourceDictionary>
