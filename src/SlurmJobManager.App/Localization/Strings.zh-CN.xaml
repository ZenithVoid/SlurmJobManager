    <sys:String x:Key="Btn.LoadOlder">▲ 较旧</sys:String>
    <sys:String x:Key="Btn.LoadLatest">⟳ 最新</sys:String>
    <sys:String x:Key="Btn.LoadNewer">▼ 较新</sys:String>
    <sys:String x:Key="Btn.CancelLoad">✕ 取消</sys:String>
    <sys:String x:Key="Btn.TestConnection">🔌 测试连接</sys:String>
    <sys:String x:Key="Btn.RefreshMonitor">🔄 刷新监控</sys:String>
