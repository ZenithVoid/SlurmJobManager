    <sys:String x:Key="Log.Title">日志查看器</sys:String>
    <sys:String x:Key="Log.RemoteFilePath">远程文件路径</sys:String>
    <sys:String x:Key="Log.LinesPerChunk">每次加载行数：</sys:String>
    <sys:String x:Key="Log.FollowMode">跟随模式（tail）</sys:String>
    <sys:String x:Key="Log.Interval">间隔 (秒)：</sys:String>

    <!-- ── 设置视图 ─────────────────────────────────────────────────────── -->
    <sys:String x:Key="Settings.Title">设置</sys:String>
    <sys:String x:Key="Settings.SshConnection">SSH 连接</sys:String>
    <sys:String x:Key="Settings.Appearance">外观</sys:String>
    <sys:String x:Key="Settings.Theme">主题：</sys:String>
    <sys:String x:Key="Settings.ThemeDesc">在深色（Catppuccin Mocha）与浅色（Catppuccin Latte）主题间切换。</sys:String>
    <sys:String x:Key="Settings.ThemeDark">🌙 切换深色</sys:String>
    <sys:String x:Key="Settings.ThemeLight">☀ 切换浅色</sys:String>
    <sys:String x:Key="Settings.PollingPerf">轮询 &amp; 性能</sys:String>
    <sys:String x:Key="Settings.PollIntervalLabel">监控轮询间隔（秒）</sys:String>
    <sys:String x:Key="Settings.PollIntervalDesc">越低的数值更新越快，但会增加 SSH 负载。</sys:String>
    <sys:String x:Key="Settings.Language">语言</sys:String>
    <sys:String x:Key="Settings.LanguageLabel">界面语言：</sys:String>
    <sys:String x:Key="Settings.LangZhCN">中文（简体）</sys:String>
    <sys:String x:Key="Settings.LangEnUS">English (US)</sys:String>
    <sys:String x:Key="Settings.About">关于</sys:String>
    <sys:String x:Key="Settings.AppName">Slurm 作业管理器</sys:String>
    <sys:String x:Key="Settings.AppDesc">一款用于通过 SSH 提交、监控和调试 Slurm HPC 作业的现代 WPF 应用。</sys:String>

    <!-- ── 错误/提示 ─────────────────────────────────────────────────────── -->
    <sys:String x:Key="Err.ConnectionFailed">连接失败，请检查服务器配置。</sys:String>
    <sys:String x:Key="Err.AuthFailed">身份验证失败，请检查用户名和密码。</sys:String>
    <sys:String x:Key="Err.Timeout">操作超时，请重试。</sys:String>
    <sys:String x:Key="Err.NoJobSelected">未选择作业。</sys:String>
    <!-- ── 连接视图 ─────────────────────────────────────────────────────── -->
    <sys:String x:Key="Conn.SshConnection">SSH 连接</sys:String>
    <sys:String x:Key="Conn.Host">主机</sys:String>
    <sys:String x:Key="Conn.Port">端口</sys:String>
    <sys:String x:Key="Conn.Username">用户名</sys:String>
    <sys:String x:Key="Conn.Password">密码</sys:String>
    <sys:String x:Key="Conn.PrivateKey">私钥（可选）</sys:String>
    <sys:String x:Key="Conn.Passphrase">密钥口令（可选）</sys:String>
    <sys:String x:Key="Tooltip.SaveProfile">保存连接配置（密码经 DPAPI 加密）</sys:String>
    <sys:String x:Key="Tooltip.LoadProfile">加载已保存的连接配置</sys:String>

