<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ── 标题栏 ──────────────────────────────────────────────────────── -->
    <sys:String x:Key="TitleBar.Minimize">最小化</sys:String>
    <sys:String x:Key="TitleBar.Maximize">最大化</sys:String>
    <sys:String x:Key="TitleBar.Restore">还原</sys:String>
    <sys:String x:Key="TitleBar.Close">关闭</sys:String>

    <!-- ── 侧边栏导航 ──────────────────────────────────────────────────── -->
    <sys:String x:Key="Nav.Dashboard">仪表盘</sys:String>
    <sys:String x:Key="Nav.Tasks">任务</sys:String>
    <sys:String x:Key="Nav.Monitor">监控</sys:String>
    <sys:String x:Key="Nav.Logs">日志</sys:String>
    <sys:String x:Key="Nav.Console">终端</sys:String>
    <sys:String x:Key="Nav.Settings">设置</sys:String>

    <!-- ── 应用标题 ─────────────────────────────────────────────────────── -->
    <sys:String x:Key="App.Title">Slurm 作业管理器</sys:String>
    <sys:String x:Key="App.TitleLine1">Slurm 作业</sys:String>
    <sys:String x:Key="App.TitleLine2">管理器</sys:String>

    <!-- ── 通用按钮 ──────────────────────────────────────────────────────── -->
    <sys:String x:Key="Btn.Refresh">刷新</sys:String>
    <sys:String x:Key="Btn.Cancel">取消</sys:String>
    <sys:String x:Key="Btn.Connect">连接</sys:String>
    <sys:String x:Key="Btn.Disconnect">断开</sys:String>
    <sys:String x:Key="Btn.Save">保存</sys:String>
    <sys:String x:Key="Btn.Close">关闭</sys:String>
