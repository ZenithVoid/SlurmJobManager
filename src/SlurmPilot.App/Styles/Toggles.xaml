<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Unified Toggle-Switch style for CheckBox.
          On  → blue  track (#2979FF) + white  thumb shifted right
          Off → gray  track (#44444C) + light-gray thumb on left

        Root-cause fix
        ══════════════
        The previous implementation animated Brush objects via property-path
        strings (e.g. "(Border.Background).(SolidColorBrush.Color)").  When a
        Trigger.Setter replaces an element's Background with a shared Setter
        value, WPF freezes that SolidColorBrush, and the subsequent animation
        throws InvalidOperationException: "Cannot animate a frozen Freezable".

        Trigger.Setter cannot use TargetName on Freezable objects (MC4111).

        Solution: VisualStateManager
        ─────────────────────────────
        • TrackBrush / ThumbBrush are per-instance SolidColorBrush elements
          defined inline with <x:Name> inside the ControlTemplate, so they are
          never shared or frozen.
        • All state-driven changes go through VisualStateManager Storyboards,
          which target named objects via Storyboard.TargetName — valid for any
          named DependencyObject, including Freezables.
        • CheckBox inherits ToggleButton's VSM GoToState calls for
          "Checked"/"Unchecked"/"Indeterminate" (CheckStates) and
          "Normal"/"MouseOver"/"Pressed"/"Disabled" (CommonStates),
          so no code-behind is required.
        • VisualTransition Storyboards drive the animated transitions; the
          VisualState Storyboards (Duration=0) define the settled appearance
          and are seeked-to-end instantly on first load (useTransitions=false).
        • Hover/press feedback uses a named Border overlay (UIElement) whose
          Opacity is animated — no Brush replacement occurs.
        Row-click linkage: wrap the CheckBox in a Label with Target binding.
    -->

    <Style TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle"       Value="{x:Null}" />
        <Setter Property="Cursor"                 Value="Hand" />
        <Setter Property="VerticalAlignment"      Value="Center" />
        <Setter Property="SnapsToDevicePixels"    Value="True" />
        <Setter Property="UseLayoutRounding"      Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Root border is named so the Disabled state can dim the whole control. -->
                    <Border x:Name="Root"
                            Background="Transparent"
                            Height="26"
                            SnapsToDevicePixels="True">

                        <VisualStateManager.VisualStateGroups>

                            <!-- ── Check state group ──────────────────────────────── -->
                            <VisualStateGroup x:Name="CheckStates">

                                <!-- Animated transitions between Checked / Unchecked -->
                                <VisualStateGroup.Transitions>
                                    <VisualTransition From="Unchecked" To="Checked">
                                        <Storyboard>
                                            <ThicknessAnimation
                                                Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="Margin"
                                                To="21,0,0,0" Duration="0:0:0.15">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                            <!-- Target the named per-instance brush directly.
                                                 Storyboard.TargetName is valid for any named
                                                 DependencyObject — no frozen-brush issue. -->
                                            <ColorAnimation
                                                Storyboard.TargetName="TrackBrush"
                                                Storyboard.TargetProperty="Color"
                                                To="#2979FF" Duration="0:0:0.15" />
                                            <ColorAnimation
                                                Storyboard.TargetName="ThumbBrush"
                                                Storyboard.TargetProperty="Color"
                                                To="White" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition From="Checked" To="Unchecked">
                                        <Storyboard>
                                            <ThicknessAnimation
                                                Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="Margin"
                                                To="3,0,0,0" Duration="0:0:0.15">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                            <ColorAnimation
                                                Storyboard.TargetName="TrackBrush"
                                                Storyboard.TargetProperty="Color"
                                                To="#44444C" Duration="0:0:0.15" />
                                            <ColorAnimation
                                                Storyboard.TargetName="ThumbBrush"
                                                Storyboard.TargetProperty="Color"
                                                To="#A0A0AC" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>

                                <!-- Settled "Checked" appearance (seeked-to-end on initial load). -->
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ThicknessAnimation
                                            Storyboard.TargetName="Thumb"
                                            Storyboard.TargetProperty="Margin"
                                            To="21,0,0,0" Duration="0" />
                                        <ColorAnimation
                                            Storyboard.TargetName="TrackBrush"
                                            Storyboard.TargetProperty="Color"
                                            To="#2979FF" Duration="0" />
                                        <ColorAnimation
                                            Storyboard.TargetName="ThumbBrush"
                                            Storyboard.TargetProperty="Color"
                                            To="White" Duration="0" />
                                    </Storyboard>
                                </VisualState>

                                <!-- Settled "Unchecked" appearance. -->
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <ThicknessAnimation
                                            Storyboard.TargetName="Thumb"
                                            Storyboard.TargetProperty="Margin"
                                            To="3,0,0,0" Duration="0" />
                                        <ColorAnimation
                                            Storyboard.TargetName="TrackBrush"
                                            Storyboard.TargetProperty="Color"
                                            To="#44444C" Duration="0" />
                                        <ColorAnimation
                                            Storyboard.TargetName="ThumbBrush"
                                            Storyboard.TargetProperty="Color"
                                            To="#A0A0AC" Duration="0" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Indeterminate" />

                            </VisualStateGroup>

                            <!-- ── Common state group (hover / press / disabled) ───── -->
                            <VisualStateGroup x:Name="CommonStates">

                                <!-- Smooth 100 ms fade for hover-overlay opacity changes -->
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.1" />
                                </VisualStateGroup.Transitions>

                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverOverlay"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.12" Duration="0" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverOverlay"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.28" Duration="0" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Root"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.4" Duration="0" />
                                    </Storyboard>
                                </VisualState>

                            </VisualStateGroup>

                        </VisualStateManager.VisualStateGroups>

                        <Grid VerticalAlignment="Center" Width="40" Height="22">

                            <!-- Track: per-instance named brush (never frozen, safely animated) -->
                            <Border x:Name="Track"
                                    CornerRadius="11"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <Border.Background>
                                    <SolidColorBrush x:Name="TrackBrush" Color="#44444C" />
                                </Border.Background>
                            </Border>

                            <!-- Semi-transparent white overlay for hover/press feedback.
                                 Targeting a UIElement's Opacity is always valid. -->
                            <Border x:Name="HoverOverlay"
                                    CornerRadius="11"
                                    Background="White"
                                    Opacity="0"
                                    IsHitTestVisible="False" />

                            <!-- Thumb: per-instance named brush; Margin drives position. -->
                            <Ellipse x:Name="Thumb"
                                     Width="16" Height="16"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="3,0,0,0"
                                     SnapsToDevicePixels="True"
                                     UseLayoutRounding="True">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="ThumbBrush" Color="#A0A0AC" />
                                </Ellipse.Fill>
                            </Ellipse>

                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
