<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SlurmPilot.App.Converters">

    <conv:LocalizationKeyConverter x:Key="LocalizationKeyConverter" />

    <!-- ── Sidebar navigation styles ─────────────────────────────────────── -->

    <!-- Individual nav item (ListBoxItem container) -->
    <Style x:Key="SidebarNavItemStyle" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle"      Value="{x:Null}" />
        <Setter Property="Cursor"                Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Height="46">
                        <!-- Selection/hover background -->
                        <Border x:Name="BgBd"
                                Background="Transparent"
                                Margin="6,2" CornerRadius="6" />
                        <!-- Left accent bar for selected state -->
                        <Border x:Name="AccentBar"
                                Width="3" HorizontalAlignment="Left"
                                CornerRadius="0,3,3,0"
                                Background="Transparent" />
                        <!-- Icon + Label row -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="20,0,12,0">
                            <TextBlock x:Name="IconText"
                                       Text="{Binding Icon}"
                                       FontSize="15"
                                       Width="22"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="LabelText"
                                       Text="{Binding LocalizationKey,
                                                       Converter={StaticResource LocalizationKeyConverter}}"
                                       FontSize="13"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="BgBd"      Property="Background"
                                    Value="{DynamicResource BgSurface0Brush}" />
                            <Setter TargetName="AccentBar" Property="Background"
                                    Value="{DynamicResource AccentBlueBrush}" />
                            <Setter TargetName="IconText"  Property="Foreground"
                                    Value="{DynamicResource AccentBlueBrush}" />
                            <Setter TargetName="LabelText" Property="Foreground"
                                    Value="{DynamicResource AccentBlueBrush}" />
                            <Setter TargetName="LabelText" Property="FontWeight"
                                    Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected"  Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="BgBd" Property="Background"
                                    Value="{DynamicResource BgCardBrush}" />
                            <Setter TargetName="IconText"  Property="Foreground"
                                    Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="LabelText" Property="Foreground"
                                    Value="{DynamicResource TextPrimaryBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar ListBox (the nav list itself) -->
    <Style x:Key="SidebarListBoxStyle" TargetType="ListBox">
        <Setter Property="Background"        Value="Transparent" />
        <Setter Property="BorderThickness"   Value="0" />
        <Setter Property="Padding"           Value="0,4" />
        <Setter Property="FocusVisualStyle"  Value="{x:Null}" />
        <Setter Property="ItemContainerStyle"
                Value="{StaticResource SidebarNavItemStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto" />
    </Style>

    <!-- Codex-like plugin section: a flat disclosure row instead of the native Expander chrome. -->
    <Style x:Key="PluginMenuToggleStyle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Height="44" Margin="6,2">
                        <Border x:Name="RowBackground" Background="Transparent" CornerRadius="6" />
                        <Grid Margin="10,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Chevron" Width="7" Height="5" Stretch="Fill"
                                  Fill="{DynamicResource TextMutedBrush}"
                                  Data="M 0 0 L 7 0 L 3.5 5 Z"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform Angle="-90" /></Path.RenderTransform>
                            </Path>
                            <Grid Grid.Column="1" Width="20" Height="20">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,8" Fill="{DynamicResource AccentBlueBrush}" />
                                <Ellipse Width="7" Height="7" Margin="8,0,0,8" Fill="{DynamicResource AccentBlueBrush}" Opacity="0.7" />
                                <Ellipse Width="7" Height="7" Margin="0,8,8,0" Fill="{DynamicResource AccentBlueBrush}" Opacity="0.7" />
                                <Ellipse Width="7" Height="7" Margin="8,8,0,0" Fill="{DynamicResource AccentBlueBrush}" />
                            </Grid>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource BgCardBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PluginSubmenuButtonStyle" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RowBackground" Height="38" Background="Transparent" CornerRadius="6"
                            Padding="7,0" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource BgCardBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="True">
                            <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource BgSurface0Brush}" />
                            <Setter TargetName="RowBackground" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PluginUnloadButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Background" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource BgCardBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Legacy TabControl styles (kept for backward compatibility) ──── -->

    <Style TargetType="TabControl">
        <Setter Property="Background"  Value="{DynamicResource BgBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
        <Setter Property="Padding"    Value="10,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="6,6,0,0"
                            Margin="2,4,2,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Content"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd"      Property="Background"
                                    Value="{DynamicResource BgBaseBrush}" />
                            <Setter TargetName="Content" Property="TextElement.Foreground"
                                    Value="{DynamicResource AccentBlueBrush}" />
                            <Setter TargetName="Content" Property="TextElement.FontWeight"
                                    Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GridSplitter -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background"          Value="{DynamicResource BorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>
