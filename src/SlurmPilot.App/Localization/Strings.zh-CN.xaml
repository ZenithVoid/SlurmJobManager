    <sys:String x:Key="About.Title">关于</sys:String>
    <sys:String x:Key="About.Subtitle">面向 Slurm 任务交付与运维的 SSH 桌面工具。</sys:String>
    <sys:String x:Key="About.BasicInfoTitle">产品信息</sys:String>
    <sys:String x:Key="About.VersionLabel">版本号：</sys:String>
