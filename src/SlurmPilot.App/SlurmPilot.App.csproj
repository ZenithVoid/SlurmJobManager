<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SlurmPilot.App</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\AppIcon\slurmpilot.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <ProjectReference Include="..\SlurmPilot.Core\SlurmPilot.Core.csproj" />
    <ProjectReference Include="..\SlurmPilot.Infrastructure\SlurmPilot.Infrastructure.csproj" />
    <ProjectReference Include="..\SlurmPilot.Plugin.Abstractions\SlurmPilot.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\SlurmPilot.SamplePlugin\SlurmPilot.SamplePlugin.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SlurmPilot.VolumeTiffPlugin\SlurmPilot.VolumeTiffPlugin.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="XTerm.NET" Version="1.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon\slurmpilot.ico" />
    <Resource Include="Assets\AppIcon\slurmpilot.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\COPYRIGHT" Link="COPYRIGHT" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <UpdaterTargetFramework>net10.0-windows</UpdaterTargetFramework>
    <UpdaterProjectDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../SlurmPilot.Updater'))</UpdaterProjectDirectory>
    <UpdaterProjectPath>$(UpdaterProjectDirectory)/SlurmPilot.Updater.csproj</UpdaterProjectPath>
    <UpdaterOutputBaseDirectory>$(UpdaterProjectDirectory)/bin/$(Configuration)/$(UpdaterTargetFramework)</UpdaterOutputBaseDirectory>
    <UpdaterOutputRidDirectory>$(UpdaterOutputBaseDirectory)/$(RuntimeIdentifier)</UpdaterOutputRidDirectory>
  </PropertyGroup>

  <Target Name="_ResolveUpdaterArtifacts">
    <MSBuild Projects="$(UpdaterProjectPath)"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)" />
    <PropertyGroup>
      <UpdaterResolvedOutputDirectory Condition="'$(RuntimeIdentifier)' != '' and Exists('$(UpdaterOutputRidDirectory)')">$(UpdaterOutputRidDirectory)</UpdaterResolvedOutputDirectory>
      <UpdaterResolvedOutputDirectory Condition="'$(UpdaterResolvedOutputDirectory)' == '' and Exists('$(UpdaterOutputBaseDirectory)')">$(UpdaterOutputBaseDirectory)</UpdaterResolvedOutputDirectory>
    </PropertyGroup>
    <Error Condition="'$(UpdaterResolvedOutputDirectory)' == ''"
           Text="Unable to locate SlurmPilot.Updater build output. Searched '$(UpdaterOutputRidDirectory)' and '$(UpdaterOutputBaseDirectory)'. App Configuration='$(Configuration)', RuntimeIdentifier='$(RuntimeIdentifier)', SelfContained='$(SelfContained)'. Ensure updater build/publish settings are compatible." />
    <ItemGroup>
      <UpdaterLaunchArtifactCandidate Include="$(UpdaterResolvedOutputDirectory)/SlurmPilot.Updater.exe" />
      <UpdaterLaunchArtifactCandidate Include="$(UpdaterResolvedOutputDirectory)/SlurmPilot.Updater.dll" />
      <UpdaterLaunchArtifactFound Include="@(UpdaterLaunchArtifactCandidate)" Condition="Exists('%(UpdaterLaunchArtifactCandidate.Identity)')" />
      <UpdaterRequiredArtifact Include="$(UpdaterResolvedOutputDirectory)/SlurmPilot.Updater.deps.json" />
      <UpdaterRequiredArtifact Include="$(UpdaterResolvedOutputDirectory)/SlurmPilot.Updater.runtimeconfig.json" />
      <MissingUpdaterRequiredArtifact Include="@(UpdaterRequiredArtifact)" Condition="!Exists('%(UpdaterRequiredArtifact.Identity)')" />
      <!--
        Non-RID updater output is expected to be a flat directory for this project, so only top-level files are copied.
        RID-specific output may contain runtime subdirectories and therefore uses recursive copy.
      -->
      <UpdaterArtifactsToCopy Include="$(UpdaterResolvedOutputDirectory)/*.*"
                              Condition="'$(UpdaterResolvedOutputDirectory)' == '$(UpdaterOutputBaseDirectory)'" />
      <UpdaterArtifactsToCopy Include="$(UpdaterResolvedOutputDirectory)/**/*.*"
                              Condition="'$(UpdaterResolvedOutputDirectory)' != '$(UpdaterOutputBaseDirectory)'" />
    </ItemGroup>
    <Error Condition="'@(UpdaterLaunchArtifactFound)' == ''"
           Text="Missing updater launch artifact from '$(UpdaterResolvedOutputDirectory)'. Expected one of: @(UpdaterLaunchArtifactCandidate, ', '). App Configuration='$(Configuration)', RuntimeIdentifier='$(RuntimeIdentifier)'." />
    <Error Condition="'@(MissingUpdaterRequiredArtifact)' != ''"
           Text="Missing required updater artifacts from '$(UpdaterResolvedOutputDirectory)'. Missing: @(MissingUpdaterRequiredArtifact, ', '). App Configuration='$(Configuration)', RuntimeIdentifier='$(RuntimeIdentifier)'. Rebuild SlurmPilot.Updater with matching publish/build settings." />
  </Target>

  <Target Name="CopyUpdaterArtifactsToBuildOutput" AfterTargets="Build">
    <CallTarget Targets="_ResolveUpdaterArtifacts" />
    <Copy SourceFiles="@(UpdaterArtifactsToCopy)"
          DestinationFiles="@(UpdaterArtifactsToCopy->'$(OutDir)Updater\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyUpdaterArtifactsToPublishOutput" AfterTargets="Publish">
    <CallTarget Targets="_ResolveUpdaterArtifacts" />
    <Copy SourceFiles="@(UpdaterArtifactsToCopy)"
          DestinationFiles="@(UpdaterArtifactsToCopy->'$(PublishDir)Updater\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBundledPluginsToBuildOutput" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)plugin" />
    <ItemGroup>
      <VolumePluginArtifacts Include="$(MSBuildProjectDirectory)\..\SlurmPilot.VolumeTiffPlugin\bin\$(Configuration)\net10.0-windows\*.*;$(MSBuildProjectDirectory)\..\SlurmPilot.VolumeTiffPlugin\bin\$(Configuration)\net10.0-windows\runtimes\win-*\**\*.*"
                             Exclude="$(MSBuildProjectDirectory)\..\SlurmPilot.VolumeTiffPlugin\bin\$(Configuration)\net10.0-windows\SlurmPilot.Plugin.Abstractions.*" />
    </ItemGroup>
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\SlurmPilot.SamplePlugin\bin\$(Configuration)\net10.0-windows\SlurmPilot.SamplePlugin.dll"
          DestinationFolder="$(OutDir)plugin"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(VolumePluginArtifacts)"
          DestinationFiles="@(VolumePluginArtifacts->'$(OutDir)plugin\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBundledPluginsToPublishOutput" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)plugin" />
    <ItemGroup>
      <VolumePluginPublishArtifacts Include="$(MSBuildProjectDirectory)\..\SlurmPilot.VolumeTiffPlugin\bin\$(Configuration)\net10.0-windows\*.*;$(MSBuildProjectDirectory)\..\SlurmPilot.VolumeTiffPlugin\bin\$(Configuration)\net10.0-windows\runtimes\win-*\**\*.*"
                                    Exclude="$(MSBuildProjectDirectory)\..\SlurmPilot.VolumeTiffPlugin\bin\$(Configuration)\net10.0-windows\SlurmPilot.Plugin.Abstractions.*" />
    </ItemGroup>
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\SlurmPilot.SamplePlugin\bin\$(Configuration)\net10.0-windows\SlurmPilot.SamplePlugin.dll"
          DestinationFolder="$(PublishDir)plugin"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(VolumePluginPublishArtifacts)"
          DestinationFiles="@(VolumePluginPublishArtifacts->'$(PublishDir)plugin\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
