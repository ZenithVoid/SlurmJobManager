<UserControl
    x:Class="SlurmPilot.App.Views.Shared.EmptyStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SlurmPilot.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="Root"
    d:DesignHeight="400" d:DesignWidth="600">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="360">

            <!-- Logo icon box -->
            <Border Width="96" Height="96"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="2"
                    CornerRadius="20"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center">
                <TextBlock Text="{Binding Icon, ElementName=Root}"
                           FontSize="46"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBlueBrush}" />
            </Border>

            <!-- Primary message -->
            <TextBlock Text="{Binding EmptyTitle, ElementName=Root}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,8" />

            <!-- Secondary hint -->
            <TextBlock Text="{Binding EmptyHint, ElementName=Root}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24" />

            <!-- Optional action button -->
            <Button Content="{Binding EmptyActionLabel, ElementName=Root}"
                    Command="{Binding EmptyActionCommand, ElementName=Root}"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Padding="20,8"
                    Visibility="{Binding HasEmptyAction, ElementName=Root,
                                         Converter={StaticResource BoolToVis}}" />

        </StackPanel>
    </Grid>

</UserControl>
