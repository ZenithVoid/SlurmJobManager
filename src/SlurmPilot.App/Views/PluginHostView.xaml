<UserControl x:Class="SlurmPilot.App.Views.PluginHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SlurmPilot.App.Converters">
    <UserControl.Resources>
        <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountToVis" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Plugins.Title}"
                           FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding StatusText}" Margin="0,5,0,0" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource Plugins.Reload}"
                    Command="{Binding ReloadCommand}" Style="{StaticResource NeutralButtonStyle}" Padding="14,7" />
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Plugins.Count, Converter={StaticResource ZeroCountToVis}}">
                    <TextBlock Text="🧩" FontSize="38" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Plugins.Empty}" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding PluginDirectory}" Margin="0,6,0,0" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <ContentControl Content="{Binding SelectedPlugin.View}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
