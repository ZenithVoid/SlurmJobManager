<Window
    x:Class="SlurmPilot.App.Views.TrayMonitorFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="560"
    Height="430"
    WindowStyle="None"
    AllowsTransparency="True"
    ResizeMode="NoResize"
    ShowActivated="True"
    ShowInTaskbar="False"
    Topmost="True"
    Background="Transparent">
    <Window.Resources>
        <Style x:Key="TrayMonitorCellTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TrayMonitorHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard"
            Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18"
            Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              Opacity="0.28"
                              ShadowDepth="8"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{DynamicResource Tray.MonitorFlyoutTitle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Tray.MonitorFlyoutSubtitle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="&#xE8A7;"
                        Width="34"
                        Height="32"
                        Padding="0"
                        Margin="0,0,8,0"
                        FontFamily="Segoe MDL2 Assets"
                        ToolTip="{DynamicResource Tray.Open}"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OpenMainButton_Click" />

                <Button Grid.Column="2"
                        x:Name="PinButton"
                        Content="📌"
                        Width="34"
                        Height="32"
                        Padding="0"
                        Margin="0,0,8,0"
                        ToolTip="{DynamicResource Tray.PinFlyout}"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="PinButton_Click" />

                <Button Grid.Column="3"
                        Content="⌄"
                        Width="34"
                        Height="32"
                        Padding="0"
                        ToolTip="{DynamicResource Tray.HideFlyout}"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="HideButton_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Border Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="0">
                    <DataGrid ItemsSource="{Binding Monitor.CurrentJobs}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              BorderThickness="0"
                              MinRowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Monitor.ColJobId}"
                                                Binding="{Binding JobId}"
                                                Width="95"
                                                HeaderStyle="{StaticResource TrayMonitorHeaderStyle}"
                                                ElementStyle="{StaticResource TrayMonitorCellTextStyle}" />
                            <DataGridTextColumn Header="{DynamicResource Monitor.ColName}"
                                                Binding="{Binding JobName}"
                                                Width="1.6*"
                                                HeaderStyle="{StaticResource TrayMonitorHeaderStyle}"
                                                ElementStyle="{StaticResource TrayMonitorCellTextStyle}" />
                            <DataGridTextColumn Header="{DynamicResource Monitor.ColUser}"
                                                Binding="{Binding User}"
                                                Width="1*"
                                                HeaderStyle="{StaticResource TrayMonitorHeaderStyle}"
                                                ElementStyle="{StaticResource TrayMonitorCellTextStyle}" />
                            <DataGridTextColumn Header="{DynamicResource Monitor.ColRunTime}"
                                                Binding="{Binding RunTimeDisplay}"
                                                Width="110"
                                                HeaderStyle="{StaticResource TrayMonitorHeaderStyle}"
                                                ElementStyle="{StaticResource TrayMonitorCellTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock Text="{DynamicResource Tray.MonitorFlyoutEmpty}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Monitor.CurrentJobs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</Window>
