<Window
    x:Class="SlurmPilot.App.Views.Dialogs.TaskValidationDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SlurmPilot.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{Binding Title}"
    Width="900"
    MinWidth="760"
    Height="620"
    MinHeight="500"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource BgBaseBrush}">
    <Window.Resources>
        <conv:StyleKeyToStyleConverter x:Key="StyleKeyToStyle" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding SummaryText}"
                   Style="{StaticResource SectionHeaderStyle}"
                   Margin="0,0,0,6" />

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Style="{Binding StatusStyleKey, Converter={StaticResource StyleKeyToStyle}}"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap" />

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="{DynamicResource Task.Validation.Refresh}"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource NeutralButtonStyle}"
                            Padding="10,4"
                            Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Task.Validation.ApplyAllFixes}"
                            Command="{Binding ApplyAllFixesCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="10,4" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Issues}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding SeverityText}"
                                                   Style="{Binding SeverityStyleKey, Converter={StaticResource StyleKeyToStyle}}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{DynamicResource Task.Validation.BlockingTag}"
                                               Style="{StaticResource ErrorTextStyle}"
                                               Margin="8,0,0,0"
                                               Visibility="{Binding IsBlocking, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Description}"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />

                                    <Button Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Content="{Binding QuickFixText}"
                                            Command="{Binding DataContext.ApplyFixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Padding="10,4"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding CanQuickFix, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{DynamicResource Task.Validation.NoIssueHint}"
                   Style="{StaticResource MutedTextStyle}"
                   Margin="0,8,0,0"
                   Visibility="{Binding HasAnyIssue, Converter={StaticResource InverseBoolToVis}}" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="{DynamicResource Btn.Cancel}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Padding="12,5"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button Content="{Binding ContinueButtonText}"
                    Style="{StaticResource SuccessButtonStyle}"
                    Padding="12,5"
                    IsEnabled="{Binding CanContinue}"
                    Click="Continue_Click" />
        </StackPanel>
    </Grid>
</Window>
