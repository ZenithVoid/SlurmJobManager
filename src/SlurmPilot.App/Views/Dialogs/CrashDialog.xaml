<Window
    x:Class="SlurmPilot.App.Views.Dialogs.CrashDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="程序发生严重错误"
    Width="720" Height="560"
    MinWidth="480" MinHeight="400"
    WindowStartupLocation="CenterScreen"
    Topmost="True"
    ResizeMode="CanResize"
    ShowInTaskbar="True"
    Background="#1E1E2E">

    <Window.Resources>
        <!-- Inline colours so this dialog is self-contained even before theme is loaded -->
        <SolidColorBrush x:Key="DlgBgBase"    Color="#1E1E2E" />
        <SolidColorBrush x:Key="DlgBgPanel"   Color="#2A2A3E" />
        <SolidColorBrush x:Key="DlgBgCard"    Color="#252535" />
        <SolidColorBrush x:Key="DlgBorder"    Color="#3A3A5C" />
        <SolidColorBrush x:Key="DlgTextMain"  Color="#CDD6F4" />
        <SolidColorBrush x:Key="DlgTextMuted" Color="#A6ADC8" />
        <SolidColorBrush x:Key="DlgRed"       Color="#F38BA8" />
        <SolidColorBrush x:Key="DlgYellow"    Color="#F9E2AF" />
        <SolidColorBrush x:Key="DlgBlue"      Color="#89B4FA" />
        <SolidColorBrush x:Key="DlgGreen"     Color="#A6E3A1" />
        <SolidColorBrush x:Key="DlgOnAccent"  Color="#1E1E2E" />
        <SolidColorBrush x:Key="DlgSurface2"  Color="#585B70" />

        <!-- Scrollbar style for the stack trace box -->
        <Style x:Key="CrashScrollBar" TargetType="ScrollBar">
            <Setter Property="Width"      Value="8" />
            <Setter Property="Background" Value="#1A1A28" />
        </Style>

        <!-- Reusable label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DlgTextMuted}" />
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="Margin"     Value="0,0,0,2" />
        </Style>

        <!-- Reusable value style -->
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{StaticResource DlgTextMain}" />
            <Setter Property="FontSize"     Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin"       Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource DlgBgBase}" Padding="0">
        <DockPanel>

            <!-- ── Header bar ─────────────────────────────────────────────── -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource DlgBgPanel}"
                    BorderBrush="{StaticResource DlgBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="20,14">
                <StackPanel>
                    <TextBlock Text="⚠  程序发生严重错误"
                               Foreground="{StaticResource DlgRed}"
                               FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="应用将在关闭前显示错误详情，请复制后反馈。"
                               Foreground="{StaticResource DlgTextMuted}"
                               FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ── Button row ─────────────────────────────────────────────── -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource DlgBgPanel}"
                    BorderBrush="{StaticResource DlgBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="20,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📋  复制错误详情"
                            Command="{Binding CopyDetailsCommand}"
                            Padding="14,7" Margin="0,0,8,0"
                            FontSize="13" FontWeight="SemiBold"
                            Foreground="{StaticResource DlgOnAccent}"
                            Background="{StaticResource DlgBlue}"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.65" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="✕  关闭程序"
                            Command="{Binding CloseAppCommand}"
                            Padding="14,7"
                            FontSize="13" FontWeight="SemiBold"
                            Foreground="{StaticResource DlgOnAccent}"
                            Background="{StaticResource DlgRed}"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.65" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ── Body ───────────────────────────────────────────────────── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,14">
                <StackPanel>

                    <!-- Metadata row: time -->
                    <TextBlock Style="{StaticResource FieldLabel}" Text="发生时间" />
                    <TextBlock Style="{StaticResource FieldValue}"
                               Text="{Binding OccurredAt}"
                               Foreground="{StaticResource DlgYellow}" />

                    <!-- Exception type -->
                    <TextBlock Style="{StaticResource FieldLabel}" Text="异常类型" />
                    <TextBlock Style="{StaticResource FieldValue}"
                               Text="{Binding ExceptionType}"
                               FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource DlgRed}" />

                    <!-- Message -->
                    <TextBlock Style="{StaticResource FieldLabel}" Text="错误消息" />
                    <TextBlock Style="{StaticResource FieldValue}"
                               Text="{Binding Message}" />

                    <!-- Location -->
                    <TextBlock Style="{StaticResource FieldLabel}" Text="发生位置" />
                    <Border Background="{StaticResource DlgBgCard}"
                            BorderBrush="{StaticResource DlgBorder}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="8,6" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Location}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource DlgYellow}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Stack trace -->
                    <TextBlock Style="{StaticResource FieldLabel}" Text="完整堆栈（可全选复制）" />
                    <Border Background="{StaticResource DlgBgCard}"
                            BorderBrush="{StaticResource DlgBorder}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="0" Height="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Padding="8,6">
                            <TextBox Text="{Binding StackTrace, Mode=OneTime}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="11"
                                     Foreground="{StaticResource DlgTextMain}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     TextWrapping="NoWrap"
                                     AcceptsReturn="False"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalScrollBarVisibility="Disabled"
                                     ContextMenu="{x:Null}" />
                        </ScrollViewer>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Border>
</Window>
